{"widgetName":"iMessage v1.1.0 Toolkit Emoji Support","widgetWidth":400,"widgetHeight":128,"headerTag":"","bodyTag":"<div id=\"notification\" class=\"container hidden\">\n  <div class=\"pfpContainer\">\n    <img id=\"pfp\" class=\"pfp\" src=\"{pfp_link}\"/>\n    <span id=\"pfpText\" class=\"pfp\" style=\"display: none;\">{pfp_initials}</span>\n    <img class=\"msgIcon\" src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/5/51/IMessage_logo.svg/3840px-IMessage_logo.svg.png\"/>\n  </div>\n  <div class=\"textContainer\">\n    <div>\n      <span id=\"sender\" class=\"sender\">{sender}</span>\n      <span class=\"timestamp\">now</span>\n    </div>\n    <span id=\"message\">{message}</span>\n  </div>\n</div>","styleTag":"html,body {\n   width: 100%;\n   height: 100%;\n   margin: 0;\n   padding: 0;\n   justify-content: center;\n   align-content: center;\n   font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n}\n\n.container {\n   display: flex;\n   align-items: center;\n   width: 100%;\n   box-sizing: border-box;\n   border-radius: 20px;\n   padding: 6px 16px;\n   margin-top: 20px;\n   gap: 12px;\n   will-change: transform;\n   background: linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(230, 230, 230, 0.75) 100%);\n}\n\n.container.hidden {\n   display: none;\n}\n\n.enter {\n  animation: enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.exit {\n  animation: exit 0.5s ease-in-out both;\n}\n\n.textContainer {\n   display: flex;\n   flex-direction: column;\n   width: 100%;\n}\n\n.sender {\n   font-weight: 600;\n}\n\n.timestamp {\n   position: absolute;\n   right: 0;\n   margin-right: 20px;\n   color: #727272;\n}\n\n.pfpContainer {\n   display: flex;\n   width: fit-content;\n   border-radius: 100px;\n   background: radial-gradient(circle at 30% 30%, #9ea0a8 0%, #7b7d86 100%);\n}\n\n.pfp {\n   display: flex;\n   width: 64px;\n   height: 64px;\n   border-radius: 100px;\n   justify-content: center;\n   align-items: center;\n   color: white;\n   font-weight: 500;\n   font-size: 24px;\n}\n\n.msgIcon {\n   width: 20px;\n   height: 20px;\n   position: absolute;\n   align-self: end;\n   margin-left: 50px;\n}\n\n@keyframes enter {\n  0% { transform: translateY(-100%); opacity: 0; }\n  40% { transform: translateY(10px); opacity: 1; }\n  60% { transform: translateY(-5px); opacity: 1; }\n  80% { transform: translateY(2px); opacity: 1; }\n  100% { transform: translateY(0); opacity: 1; }\n}\n\n@keyframes exit{\n  0% { transform: translateY(0); opacity: 1; }\n  100% { transform: translateY(-100%); opacity: 0; }\n}\n\n/* Toolkit-safe emoji images generated by Twemoji. */\n#message img.emoji,\n.sender img.emoji {\n   width: 1em;\n   height: 1em;\n   margin: 0 .04em;\n   vertical-align: -0.12em;\n   object-fit: contain;\n   display: inline-block;\n}\n","scriptTag":"const notification = document.getElementById(\"notification\");\nconst picture = document.getElementById(\"pfp\");\nconst pictureText = document.getElementById(\"pfpText\");\nconst senderEl = document.getElementById(\"sender\");\nconst messageEl = document.getElementById(\"message\");\n\nconst poglyPic = \"{pfp_pogly}\";\nlet curLink = \"{pfp_link}\";\nlet curInitials = \"{pfp_initials}\";\nlet duration = parseFloat(\"{duration}\");\nlet volume = parseFloat(\"{sound_effect_volume}\");\nlet notificationSound = \"{notification_sound_url}\";\nlet rotationIntervalMinutes = parseFloat(\"{minutes_between_messages}\");\n\nconst scheduledMessages = [\n  {\n    enabled: parseEnabled(\"{message_1_enabled}\"),\n    message: \"{message}\"\n  },\n  {\n    enabled: parseEnabled(\"{message_2_enabled}\"),\n    message: \"{message_2}\"\n  },\n  {\n    enabled: parseEnabled(\"{message_3_enabled}\"),\n    message: \"{message_3}\"\n  },\n  {\n    enabled: parseEnabled(\"{message_4_enabled}\"),\n    message: \"{message_4}\"\n  },\n  {\n    enabled: parseEnabled(\"{message_5_enabled}\"),\n    message: \"{message_5}\"\n  }\n];\n\nconst scheduleStartedAt = Date.now();\nlet schedulerTimer = 0;\nlet hideTimer = 0;\nlet nextRotationIndex = 0;\nlet lastCompletedTick = 0;\n\nlet emojiRendererReady = false;\nlet emojiRendererLoading = false;\n\nfunction renderEmojiText(element, value) {\n  if (!element) return;\n\n  element.textContent = String(value ?? \"\");\n\n  if (\n    emojiRendererReady &&\n    window.twemoji &&\n    typeof window.twemoji.parse === \"function\"\n  ) {\n    window.twemoji.parse(element, {\n      folder: \"svg\",\n      ext: \".svg\",\n      base: \"https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/\"\n    });\n  }\n}\n\nfunction refreshAllEmojiText() {\n  renderEmojiText(senderEl, senderEl.textContent);\n  renderEmojiText(messageEl, messageEl.textContent);\n}\n\nfunction loadEmojiRenderer() {\n  if (emojiRendererReady || emojiRendererLoading) return;\n\n  emojiRendererLoading = true;\n\n  const scriptElement = document.createElement(\"script\");\n  scriptElement.src =\n    \"https://cdn.jsdelivr.net/npm/twemoji@14.0.2/dist/twemoji.min.js\";\n  scriptElement.async = true;\n\n  scriptElement.onload = function() {\n    emojiRendererLoading = false;\n    emojiRendererReady = Boolean(\n      window.twemoji &&\n      typeof window.twemoji.parse === \"function\"\n    );\n\n    refreshAllEmojiText();\n  };\n\n  scriptElement.onerror = function() {\n    emojiRendererLoading = false;\n    emojiRendererReady = false;\n  };\n\n  document.head.appendChild(scriptElement);\n}\n\n\nfunction parseEnabled(value) {\n  const normalized = String(value ?? \"\").trim().toLowerCase();\n  return ![\"false\", \"0\", \"off\", \"no\", \"disabled\"].includes(normalized);\n}\n\nfunction renderPicture() {\n  if (curLink !== \"\") {\n    picture.src = curLink;\n    picture.style.display = \"flex\";\n    pictureText.style.display = \"none\";\n  } else if (poglyPic !== \"\") {\n    picture.src = poglyPic;\n    picture.style.display = \"flex\";\n    pictureText.style.display = \"none\";\n  } else {\n    picture.style.display = \"none\";\n    pictureText.style.display = \"flex\";\n    pictureText.textContent = curInitials;\n  }\n}\n\nfunction trigger(messageOverride) {\n  if (typeof messageOverride === \"string\") {\n    renderEmojiText(messageEl, messageOverride);\n  }\n\n  notification.classList.remove(\"hidden\", \"enter\", \"exit\");\n  void notification.offsetWidth;\n  notification.classList.add(\"enter\");\n\n  const sound = new Audio(\n    notificationSound || \"https://repo.pogly.gg/media/iphone.mp3\"\n  );\n\n  let normalizedVolume = Number.isFinite(volume) ? volume : 1;\n  if (normalizedVolume > 1) {\n    normalizedVolume = normalizedVolume / 100;\n  }\n\n  sound.volume = Math.max(0, Math.min(1, normalizedVolume));\n  sound.play().catch(function() {});\n\n  if (hideTimer) clearTimeout(hideTimer);\n\n  hideTimer = setTimeout(function() {\n    notification.classList.remove(\"enter\");\n    notification.classList.add(\"exit\");\n  }, (Number.isFinite(duration) ? duration : 3) * 1000);\n}\n\nfunction isMessageAvailable(item) {\n  return (\n    item &&\n    item.enabled &&\n    String(item.message || \"\").trim() !== \"\"\n  );\n}\n\nfunction getNextEnabledMessage() {\n  if (!scheduledMessages.some(isMessageAvailable)) return null;\n\n  for (let checked = 0; checked < scheduledMessages.length; checked++) {\n    const index = nextRotationIndex % scheduledMessages.length;\n    const item = scheduledMessages[index];\n\n    nextRotationIndex = (index + 1) % scheduledMessages.length;\n\n    if (isMessageAvailable(item)) {\n      return item.message;\n    }\n  }\n\n  return null;\n}\n\nfunction getIntervalMs() {\n  const minutes =\n    Number.isFinite(rotationIntervalMinutes) && rotationIntervalMinutes > 0\n      ? rotationIntervalMinutes\n      : 10;\n\n  return minutes * 60 * 1000;\n}\n\nfunction runMasterScheduler() {\n  const intervalMs = getIntervalMs();\n  const elapsed = Math.max(0, Date.now() - scheduleStartedAt);\n  const completedTicks = Math.floor(elapsed / intervalMs);\n\n  if (completedTicks <= lastCompletedTick) return;\n\n  /*\n   * Only fire once even if OBS was delayed for several intervals.\n   * Missed rotations are skipped instead of dumping alerts back-to-back.\n   */\n  lastCompletedTick = completedTicks;\n\n  const nextMessage = getNextEnabledMessage();\n  if (nextMessage !== null) {\n    trigger(nextMessage);\n  }\n}\n\nfunction startMasterScheduler() {\n  if (schedulerTimer || \"{is_overlay}\" !== \"true\") return;\n\n  lastCompletedTick = 0;\n  schedulerTimer = setInterval(runMasterScheduler, 1000);\n}\n\nfunction updateMessageSlot(index, property, value) {\n  const item = scheduledMessages[index];\n  if (!item) return;\n\n  if (property === \"enabled\") {\n    item.enabled = parseEnabled(value);\n  } else if (property === \"message\") {\n    item.message = value;\n  }\n}\n\nfunction onLiveVariableUpdate(name, value) {\n  if (name === \"sender\") {\n    renderEmojiText(senderEl, value);\n  } else if (name === \"message\") {\n    updateMessageSlot(0, \"message\", value);\n    renderEmojiText(messageEl, value);\n  } else if (name === \"duration\") {\n    duration = parseFloat(value);\n  } else if (name === \"sound_effect_volume\") {\n    volume = parseFloat(value);\n  } else if (name === \"notification_sound_url\") {\n    notificationSound = value;\n  } else if (name === \"minutes_between_messages\") {\n    rotationIntervalMinutes = parseFloat(value);\n\n    /*\n     * Changing the shared interval starts a clean rotation from that moment.\n     */\n    lastCompletedTick = 0;\n  } else if (name === \"message_1_enabled\") {\n    updateMessageSlot(0, \"enabled\", value);\n  } else if (name === \"message_2\") {\n    updateMessageSlot(1, \"message\", value);\n  } else if (name === \"message_2_enabled\") {\n    updateMessageSlot(1, \"enabled\", value);\n  } else if (name === \"message_3\") {\n    updateMessageSlot(2, \"message\", value);\n  } else if (name === \"message_3_enabled\") {\n    updateMessageSlot(2, \"enabled\", value);\n  } else if (name === \"message_4\") {\n    updateMessageSlot(3, \"message\", value);\n  } else if (name === \"message_4_enabled\") {\n    updateMessageSlot(3, \"enabled\", value);\n  } else if (name === \"message_5\") {\n    updateMessageSlot(4, \"message\", value);\n  } else if (name === \"message_5_enabled\") {\n    updateMessageSlot(4, \"enabled\", value);\n  } else if (name === \"pfp_link\") {\n    curLink = value;\n    renderPicture();\n  } else if (name === \"pfp_initials\") {\n    curInitials = value;\n    renderPicture();\n  } else if (name === \"trigger\") {\n    trigger(scheduledMessages[0].message);\n  }\n}\n\nloadEmojiRenderer();\nrenderEmojiText(senderEl, \"{sender}\");\nrenderEmojiText(messageEl, \"{message}\");\nrenderPicture();\n\nif (\"{is_overlay}\" !== \"true\") {\n  notification.classList.remove(\"hidden\");\n} else {\n  startMasterScheduler();\n}","variables":[{"variableName":"trigger","variableType":6,"variableValue":"show","variableLive":true,"variablePulse":52},{"variableName":"sound_effect_volume","variableType":7,"variableValue":"0.5","variableLive":true,"variableMin":0,"variableMax":1,"variableStep":0.1},{"variableName":"notification_sound_url","variableType":1,"variableValue":"https://marufps.github.io/MarusWidgets/sounds/iphone.mp3","variableLive":true},{"variableName":"sender","variableType":1,"variableValue":"Maru ⚔️","variableLive":true},{"variableName":"message_1_enabled","variableType":3,"variableValue":true,"variableLive":true},{"variableName":"message","variableType":1,"variableValue":"💜 Make Sure To Sub 4 No Ad's!","variableLive":true},{"variableName":"minutes_between_messages","variableType":1,"variableValue":"30","variableLive":true},{"variableName":"message_2_enabled","variableType":3,"variableValue":false,"variableLive":true},{"variableName":"message_2","variableType":1,"variableValue":"⭐ Got Prime? Claim Your FREE Prime Sub!","variableLive":true},{"variableName":"message_3_enabled","variableType":3,"variableValue":false,"variableLive":true},{"variableName":"message_3","variableType":1,"variableValue":"📲 Follow My Socials So You Never Miss A Stream!","variableLive":true},{"variableName":"message_4_enabled","variableType":3,"variableValue":false,"variableLive":true},{"variableName":"message_4","variableType":1,"variableValue":"Don't forget... a follow is completely free 💜","variableLive":true},{"variableName":"message_5_enabled","variableType":3,"variableValue":false,"variableLive":true},{"variableName":"message_5","variableType":1,"variableValue":"🔔 Turn On Twitch Notifications To Know When We Go Live!","variableLive":true},{"variableName":"pfp_link","variableType":1,"variableValue":"https://i.ibb.co/4gWb0V1K/a-2b54a616d274f780261b8622eafa20a7.gif","variableLive":true},{"variableName":"pfp_pogly","variableType":5,"variableValue":"","variableLive":false},{"variableName":"pfp_initials","variableType":1,"variableValue":"","variableLive":true},{"variableName":"duration","variableType":1,"variableValue":"5","variableLive":true}]}
