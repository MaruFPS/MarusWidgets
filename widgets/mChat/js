function parseJSONMaybe(value) {
  if (value && typeof value === "object") return value;

  try {
    return JSON.parse(String(value || "{}"));
  } catch (error) {
    return null;
  }
}

function extractKickEmotes(content, payloadEmotes = []) {
  const message = String(content || "");
  const emotes = [];

  const addEmote = (id, name, url = "") => {
    if (!id || !name) return;

    emotes.push({
      id: String(id),
      name: String(name),
      url:
        url ||
        `https://files.kick.com/emotes/${encodeURIComponent(id)}/fullsize`
    });
  };

  message.replace(
    /\[emote:(\d+):([^\]]+)\]/g,
    (full, id, name) => {
      addEmote(id, name);
      return full;
    }
  );

  const normalizedPayloadEmotes = Array.isArray(payloadEmotes)
    ? payloadEmotes
    : Object.values(payloadEmotes || {});

  normalizedPayloadEmotes.forEach(emote => {
    addEmote(
      emote?.id || emote?.emote_id || emote?.emoteId,
      emote?.name || emote?.code || emote?.text,
      emote?.url ||
        emote?.image_url ||
        emote?.imageUrl ||
        emote?.src ||
        ""
    );
  });

  return {
    original: message,
    emotes
  };
}


function getSevenTVEmoteFileUrl(emote) {
  const host = emote?.data?.host || emote?.host || {};
  const baseUrl = String(host.url || "").replace(/^\/\//, "https://");
  const files = Array.isArray(host.files) ? host.files : [];
  const file =
    files.find(item => item?.name === "4x.webp") ||
    files.find(item => item?.name === "3x.webp") ||
    files.find(item => item?.name === "2x.webp") ||
    files.find(item => item?.name === "1x.webp") ||
    files.find(item => String(item?.format || "").toUpperCase() === "WEBP") ||
    files[files.length - 1];

  if (baseUrl && file?.name) return `${baseUrl}/${file.name}`;

  const id = emote?.id || emote?.data?.id || emote?.emote_id || "";
  return id
    ? `https://cdn.7tv.app/emote/${encodeURIComponent(id)}/4x.webp`
    : "";
}

function normalizeSevenTVEmoteSet(setData) {
  const output = {};
  const emotes = Array.isArray(setData?.emotes) ? setData.emotes : [];

  emotes.forEach(entry => {
    const name = String(entry?.name || entry?.data?.name || "").trim();
    const id = entry?.id || entry?.data?.id || "";
    const url = getSevenTVEmoteFileUrl(entry);

    if (!name || !id || !url) return;

    output[name] = {
      id: String(id),
      name,
      url,
      source: "7tv",
      flags: Number(entry?.flags || 0),
      raw: entry
    };
  });

  return output;
}

async function fetchSevenTVJSON(url) {
  const response = await fetch(url, { cache: "no-store" });
  if (!response.ok) throw new Error(`7TV HTTP ${response.status}: ${url}`);
  return response.json();
}

async function loadSevenTVEmoteSet(setId, forceRefresh = false) {
  const cleanId = String(setId || "").trim();
  if (!cleanId) return {};

  if (forceRefresh) {
    delete sevenTVEmoteSetCache[cleanId];
  }

  if (!sevenTVEmoteSetCache[cleanId]) {
    const cacheBuster = forceRefresh
      ? `?refresh=${Date.now()}`
      : "";

    sevenTVEmoteSetCache[cleanId] = fetchSevenTVJSON(
      `https://7tv.io/v3/emote-sets/${encodeURIComponent(cleanId)}${cacheBuster}`
    )
      .then(normalizeSevenTVEmoteSet)
      .catch(error => {
        debugError("7TV emote set load failed:", cleanId, error);
        return {};
      });
  }

  return sevenTVEmoteSetCache[cleanId];
}

async function loadSevenTVGlobalEmoteSet() {
  const key = "__GLOBAL__";

  if (!sevenTVEmoteSetCache[key]) {
    sevenTVEmoteSetCache[key] = fetchSevenTVJSON(
      "https://7tv.io/v3/emote-sets/global"
    )
      .then(normalizeSevenTVEmoteSet)
      .catch(error => {
        debugError("7TV global emote load failed:", error);
        return {};
      });
  }

  return sevenTVEmoteSetCache[key];
}

function findSevenTVConnectionSetId(user, platform) {
  const expected = String(platform || "").toUpperCase();
  const connections = Array.isArray(user?.connections) ? user.connections : [];
  const connection = connections.find(item =>
    String(item?.platform || "").toUpperCase() === expected
  );

  return String(
    connection?.emote_set_id ||
    connection?.emoteSetId ||
    user?.emote_set?.id ||
    user?.emote_set_id ||
    ""
  ).trim();
}


async function resolveTwitchUsernameToId(username){
  const u=String(username||"").trim().toLowerCase();
  if(!u) return "";
  try{
    const r=await fetch("https://7tv.io/v3/users/twitch/"+encodeURIComponent(u),{cache:"no-store"});
    if(!r.ok) return "";
    const d=await r.json();
    return String(d?.connections?.find?.(c=>String(c.platform).toUpperCase()==="TWITCH")?.platform_id||d?.connections?.[0]?.platform_id||"");
  }catch(e){return "";}
}

async function discoverSevenTVEmoteSetId(platform, platformUserId) {
  const normalizedPlatform = String(platform || "").toUpperCase();
  const cleanId = String(platformUserId || "").trim();
  if (!cleanId) return "";

  const key = `${normalizedPlatform}:${cleanId}`;
  if (sevenTVConnectionCache[key]) return sevenTVConnectionCache[key];

  sevenTVConnectionCache[key] = (async () => {
    try {
      const restUser = await fetchSevenTVJSON(
        `https://7tv.io/v3/users/${normalizedPlatform.toLowerCase()}/${encodeURIComponent(cleanId)}`
      );
      const restId = findSevenTVConnectionSetId(restUser, normalizedPlatform);
      if (restId) return restId;
    } catch (error) {
      debugWarn("7TV REST discovery failed; trying GraphQL:", error);
    }

    try {
      const response = await fetch("https://7tv.io/v3/gql", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          operationName: "GetSevenTVChannelConnection",
          variables: { id: cleanId, platform: normalizedPlatform },
          query: `
            query GetSevenTVChannelConnection(
              $platform: ConnectionPlatform!,
              $id: String!
            ) {
              user: userByConnection(platform: $platform, id: $id) {
                connections {
                  platform
                  emote_set_id
                }
              }
            }
          `
        })
      });

      if (!response.ok) return "";
      const result = await response.json();
      return findSevenTVConnectionSetId(result?.data?.user, normalizedPlatform);
    } catch (error) {
      debugError("7TV connection discovery failed:", error);
      return "";
    }
  })();

  return sevenTVConnectionCache[key];
}

function combinedSevenTVEmotes(platform) {
  return {
    ...sevenTVGlobalEmotes,
    ...(platform === "kick"
      ? sevenTVKickChannelEmotes
      : sevenTVTwitchChannelEmotes)
  };
}

async function reloadNativeSevenTVEmotes({
  forceSetIds = [],
  reconnectEvents = true
} = {}) {
  const generation = ++sevenTVEmoteLoadGeneration;
  const forced = new Set(
    (Array.isArray(forceSetIds) ? forceSetIds : [])
      .map(value => String(value || "").trim())
      .filter(Boolean)
  );

  if (!enableNativeSevenTVEmotes) {
    sevenTVGlobalEmotes = {};
    sevenTVTwitchChannelEmotes = {};
    sevenTVKickChannelEmotes = {};
    activeSevenTVTwitchSetId = "";
    activeSevenTVKickSetId = "";
    disconnectSevenTVEventAPI();
    return;
  }

  const globalPromise = loadSevenTVGlobalEmotes
    ? loadSevenTVGlobalEmoteSet()
    : Promise.resolve({});

  const twitchPromise = (async () => {
    let platformId=twitchSevenTVPlatformId;
    if(!platformId && twitchSevenTVUsername){
      platformId=await resolveTwitchUsernameToId(twitchSevenTVUsername);
      if(platformId){debugLog("Resolved Twitch username",twitchSevenTVUsername,"->",platformId);}
    }
    const setId =
      twitchSevenTVEmoteSetOverride ||
      await discoverSevenTVEmoteSetId("TWITCH", platformId);

    activeSevenTVTwitchSetId = String(setId || "").trim();

    if (!activeSevenTVTwitchSetId) {
      debugWarn("No Twitch 7TV emote set found.");
      return {};
    }

    return loadSevenTVEmoteSet(
      activeSevenTVTwitchSetId,
      forced.has(activeSevenTVTwitchSetId)
    );
  })();

  const kickPromise = (async () => {
    const setId =
      kickSevenTVEmoteSetOverride ||
      await discoverSevenTVEmoteSetId("KICK", kickSevenTVPlatformId);

    activeSevenTVKickSetId = String(setId || "").trim();

    if (!activeSevenTVKickSetId) {
      debugWarn("No Kick 7TV emote set found.");
      return {};
    }

    return loadSevenTVEmoteSet(
      activeSevenTVKickSetId,
      forced.has(activeSevenTVKickSetId)
    );
  })();

  const [globals, twitchSet, kickSet] = await Promise.all([
    globalPromise,
    twitchPromise,
    kickPromise
  ]);

  if (generation !== sevenTVEmoteLoadGeneration) return;

  sevenTVGlobalEmotes = globals;
  sevenTVTwitchChannelEmotes = twitchSet;
  sevenTVKickChannelEmotes = kickSet;

  debugGroup("Native 7TV emotes ready", {
    globals: Object.keys(globals).length,
    twitchSetId: activeSevenTVTwitchSetId,
    twitchChannel: Object.keys(twitchSet).length,
    kickSetId: activeSevenTVKickSetId,
    kickChannel: Object.keys(kickSet).length
  });

  if (reconnectEvents) {
    connectSevenTVEventAPI();
  }
}



function clearSevenTVEventReconnectTimer() {
  if (sevenTVEventReconnectTimer) {
    clearTimeout(sevenTVEventReconnectTimer);
    sevenTVEventReconnectTimer = 0;
  }
}

function clearSevenTVEventHeartbeatTimer() {
  if (sevenTVEventHeartbeatTimer) {
    clearInterval(sevenTVEventHeartbeatTimer);
    sevenTVEventHeartbeatTimer = 0;
  }
}

function clearSevenTVEventReloadTimer() {
  if (sevenTVEventReloadTimer) {
    clearTimeout(sevenTVEventReloadTimer);
    sevenTVEventReloadTimer = 0;
  }

  if (sevenTVEventRetryTimer) {
    clearTimeout(sevenTVEventRetryTimer);
    sevenTVEventRetryTimer = 0;
  }
}

function currentSevenTVEventSetIds() {
  return [
    activeSevenTVTwitchSetId,
    activeSevenTVKickSetId
  ]
    .map(value => String(value || "").trim())
    .filter((value, index, values) =>
      value && values.indexOf(value) === index
    );
}

function disconnectSevenTVEventAPI() {
  clearSevenTVEventReconnectTimer();
  clearSevenTVEventHeartbeatTimer();
  clearSevenTVEventReloadTimer();

  sevenTVEventGeneration += 1;

  if (sevenTVEventSocket) {
    try {
      sevenTVEventSocket.close(1000, "7TV live updates disabled");
    } catch (_) {}
  }

  sevenTVEventSocket = null;
  sevenTVEventSessionId = "";
  sevenTVEventLastHeartbeatAt = 0;
}

function scheduleSevenTVEventReconnect() {
  if (
    !enableNativeSevenTVEmotes ||
    !enableSevenTVLiveUpdates ||
    currentSevenTVEventSetIds().length === 0 ||
    sevenTVEventReconnectTimer
  ) {
    return;
  }

  sevenTVEventReconnectTimer = setTimeout(() => {
    sevenTVEventReconnectTimer = 0;
    connectSevenTVEventAPI();
  }, SEVENTV_EVENT_RECONNECT_MS);
}

function subscribeSevenTVEventSets(socket) {
  const setIds = currentSevenTVEventSetIds();

  setIds.forEach(setId => {
    socket.send(JSON.stringify({
      op: 35,
      d: {
        type: "emote_set.update",
        condition: {
          object_id: setId
        }
      }
    }));
  });

  debugLog("7TV Event API subscriptions sent:", setIds);
}

function startSevenTVHeartbeatWatch(intervalMs) {
  clearSevenTVEventHeartbeatTimer();

  const safeInterval = Math.max(
    5000,
    Number(intervalMs) || 15000
  );

  sevenTVEventLastHeartbeatAt = Date.now();

  sevenTVEventHeartbeatTimer = setInterval(() => {
    const age = Date.now() - sevenTVEventLastHeartbeatAt;

    if (age > safeInterval * 3.25) {
      debugWarn("7TV Event API heartbeat timed out.");

      try {
        sevenTVEventSocket?.close();
      } catch (_) {}
    }
  }, safeInterval);
}

function extractSevenTVDispatchSetId(message) {
  return String(
    message?.d?.body?.id ||
    message?.d?.body?.object_id ||
    message?.d?.id ||
    ""
  ).trim();
}

function forceRefreshActiveSevenTVSets(reason = "update") {
  const activeSetIds = currentSevenTVEventSetIds();

  if (!activeSetIds.length) return Promise.resolve();

  debugLog(
    "Refreshing active 7TV emote sets:",
    activeSetIds,
    reason
  );

  return reloadNativeSevenTVEmotes({
    forceSetIds: activeSetIds,
    reconnectEvents: false
  });
}

function scheduleSevenTVSetRefresh(setId, reason = "update") {
  const cleanId = String(setId || "").trim();

  clearSevenTVEventReloadTimer();

  /*
   * Only our active sets are subscribed. Therefore, an emote_set.update
   * dispatch is relevant even if a newer Event API payload places the
   * object ID somewhere unexpected. Refresh both active sets rather than
   * silently ignoring a valid event because of an ID-shape mismatch.
   */
  sevenTVEventReloadTimer = setTimeout(() => {
    sevenTVEventReloadTimer = 0;

    forceRefreshActiveSevenTVSets(
      `${reason}${cleanId ? `:${cleanId}` : ""}`
    ).catch(error => {
      debugError("7TV live emote-set refresh failed:", error);
    });

    /*
     * The event stream can fire before the REST/CDN emote-set response
     * contains the new entry. A second cache-busted refresh catches that
     * propagation delay without requiring a widget refresh.
     */
    sevenTVEventRetryTimer = setTimeout(() => {
      sevenTVEventRetryTimer = 0;

      forceRefreshActiveSevenTVSets(
        `${reason}:propagation-retry`
      ).catch(error => {
        debugError("7TV live emote-set retry failed:", error);
      });
    }, 3000);
  }, 900);
}


function handleSevenTVEventMessage(message, socket, generation) {
  if (
    generation !== sevenTVEventGeneration ||
    socket !== sevenTVEventSocket
  ) {
    return;
  }

  const op = Number(message?.op);

  if (op === 1) {
    sevenTVEventSessionId = String(
      message?.d?.session_id || ""
    );

    startSevenTVHeartbeatWatch(
      message?.d?.heartbeat_interval
    );

    subscribeSevenTVEventSets(socket);
    return;
  }

  if (op === 2) {
    sevenTVEventLastHeartbeatAt = Date.now();
    return;
  }

  if (op === 0) {
    const eventType = String(message?.d?.type || "");
    const setId = extractSevenTVDispatchSetId(message);

    if (eventType === "emote_set.update") {
      scheduleSevenTVSetRefresh(setId, eventType);
    }

    return;
  }

  if (op === 4) {
    debugWarn("7TV Event API requested a reconnect.");

    try {
      socket.close();
    } catch (_) {}

    return;
  }

  if (op === 5) {
    debugLog("7TV Event API acknowledged:", message?.d);
    return;
  }

  if (op === 6) {
    debugError("7TV Event API error:", message?.d);
    return;
  }

  if (op === 7) {
    debugWarn("7TV Event API stream ended:", message?.d);

    try {
      socket.close();
    } catch (_) {}
  }
}

function connectSevenTVEventAPI() {
  clearSevenTVEventReconnectTimer();

  if (
    !enableNativeSevenTVEmotes ||
    !enableSevenTVLiveUpdates
  ) {
    disconnectSevenTVEventAPI();
    return;
  }

  const setIds = currentSevenTVEventSetIds();
  if (!setIds.length) {
    disconnectSevenTVEventAPI();
    return;
  }

  if (
    sevenTVEventSocket &&
    (
      sevenTVEventSocket.readyState === WebSocket.OPEN ||
      sevenTVEventSocket.readyState === WebSocket.CONNECTING
    )
  ) {
    /*
     * Rebuild the socket whenever the active set IDs may have changed.
     * This avoids duplicate subscriptions and guarantees the connection
     * watches exactly the current Twitch and Kick sets.
     */
    try {
      sevenTVEventSocket.close(1000, "Refreshing subscriptions");
    } catch (_) {}
  }

  const generation = ++sevenTVEventGeneration;
  const socket = new WebSocket(SEVENTV_EVENT_URL);
  sevenTVEventSocket = socket;

  socket.addEventListener("open", () => {
    if (generation !== sevenTVEventGeneration) return;
    debugLog("7TV Event API connected.");
  });

  socket.addEventListener("message", event => {
    let message;

    try {
      message = JSON.parse(event.data);
    } catch (error) {
      debugWarn("7TV Event API sent invalid JSON:", event.data);
      return;
    }

    handleSevenTVEventMessage(message, socket, generation);
  });

  socket.addEventListener("close", event => {
    if (socket === sevenTVEventSocket) {
      sevenTVEventSocket = null;
    }

    clearSevenTVEventHeartbeatTimer();

    debugWarn(
      "7TV Event API disconnected:",
      event.code,
      event.reason || "no reason"
    );

    if (generation === sevenTVEventGeneration) {
      scheduleSevenTVEventReconnect();
    }
  });

  socket.addEventListener("error", error => {
    debugWarn("7TV Event API socket error:", error);
  });
}

function normalizeBadgeType(value) {
  return String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[\s-]+/g, "_");
}

function getBadgeSettings(username = "") {
  const normalizedUsername = String(username || "")
    .trim()
    .replace(/^@/, "")
    .toLowerCase();

  const normalizedCreator = String(creatorBadgeUsername || "")
    .trim()
    .replace(/^@/, "")
    .toLowerCase();

  const useCreatorSettings =
    enableCreatorBadgeOverrides &&
    normalizedCreator &&
    normalizedUsername === normalizedCreator;

  if (useCreatorSettings) {
    return {
      showBadges: creatorShowBadges,
      maxBadges: creatorMaxBadges,
      showSubscriberBadges: creatorShowSubscriberBadges,
      showSevenTVBadges: creatorShowSevenTVBadges,
      showChatterinoBadges: creatorShowChatterinoBadges,
      showFFZBadges: creatorShowFFZBadges,
      showOtherBadges: creatorShowOtherBadges,
      showModeratorBadges: creatorShowModeratorBadges,
      showVIPBadges: creatorShowVIPBadges,
      showBroadcasterBadges: creatorShowBroadcasterBadges,
      showFounderBadges: creatorShowFounderBadges,
      showVerifiedBadges: creatorShowVerifiedBadges,
      showOGBadges: creatorShowOGBadges,
      showGifterBadges: creatorShowGifterBadges,
      showStaffBadges: creatorShowStaffBadges,
      showProfilePictures: creatorShowProfilePictures
    };
  }

  return {
    showBadges,
    maxBadges,
    showSubscriberBadges,
    showSevenTVBadges,
    showChatterinoBadges,
    showFFZBadges,
    showOtherBadges,
    showModeratorBadges,
    showVIPBadges,
    showBroadcasterBadges,
    showFounderBadges,
    showVerifiedBadges,
    showOGBadges,
    showGifterBadges,
    showStaffBadges,
    showProfilePictures: showProfilePictures
  };
}

function shouldShowBadgeType(value, settings) {
  const type = normalizeBadgeType(value);

  if (!type) return settings.showOtherBadges;

  if (
    type === "subscriber" ||
    type === "sub" ||
    type.includes("subscriber")
  ) {
    return settings.showSubscriberBadges;
  }

  if (type === "moderator" || type === "mod") {
    return settings.showModeratorBadges;
  }

  if (type === "vip") {
    return settings.showVIPBadges;
  }

  if (
    type === "broadcaster" ||
    type === "streamer" ||
    type === "owner" ||
    type === "creator" ||
    type === "host"
  ) {
    return settings.showBroadcasterBadges;
  }

  if (type === "founder") {
    return settings.showFounderBadges;
  }

  if (type === "verified" || type === "partner") {
    return settings.showVerifiedBadges;
  }

  if (type === "og") {
    return settings.showOGBadges;
  }

  if (
    type === "sub_gifter" ||
    type === "gifter" ||
    type === "bits_leader"
  ) {
    return settings.showGifterBadges;
  }

  if (
    type === "staff" ||
    type === "admin" ||
    type === "global_mod" ||
    type === "global_moderator"
  ) {
    return settings.showStaffBadges;
  }

  return settings.showOtherBadges;
}


function normalizeKickBadgeArray(value) {
  if (Array.isArray(value)) return value.filter(Boolean);
  return Object.values(value || {}).filter(Boolean);
}

function sanitizeKickBadgeSvg(value) {
  const svg = String(value || "").trim();

  if (
    !svg.startsWith("<svg") ||
    !svg.endsWith("</svg>")
  ) {
    return "";
  }

  return svg
    .replace(/<script[\s\S]*?<\/script>/gi, "")
    .replace(/\son[a-z]+\s*=\s*("[^"]*"|'[^']*')/gi, "")
    .replace(/<svg\b/i, '<svg class="kick-badge-inline-svg"');
}

function renderResolvedKickBadges(badges = [], username = "") {
  const settings = getBadgeSettings(username);
  if (!settings.showBadges) return "";

  return normalizeKickBadgeArray(badges)
    .filter(badge =>
      shouldShowBadgeType(
        String(badge?.type || "").toLowerCase(),
        settings
      )
    )
    .slice(0, Math.max(0, Number(settings.maxBadges || 999)))
    .map(badge => {
      const label = String(
        badge?.text ||
        badge?.title ||
        badge?.type ||
        "Kick badge"
      );

      const svg = sanitizeKickBadgeSvg(
        badge?.imageSvg ||
        badge?.image_svg ||
        ""
      );

      if (svg) {
        const badgeType = String(
          badge?.type || ""
        ).toLowerCase();

        return `<span
          class="badge kick-badge kick-badge-inline kick-badge-${escapeHTML(
            badgeType
          )}"
          role="img"
          aria-label="${escapeHTML(label)}"
          title="${escapeHTML(label)}"
        >${svg}</span>`;
      }

      const url = String(
        badge?.imageUrl ||
        badge?.image_url ||
        badge?.url ||
        ""
      ).trim();

      if (!url) return "";

      return `<img
        class="badge kick-badge"
        src="${escapeHTML(url)}"
        alt="${escapeHTML(label)}"
        title="${escapeHTML(label)}"
      >`;
    })
    .join("");
}

async function loadKickBadgesFromWorker(identity = {}) {
  const workerBase = cleanYouTubeWorkerUrl(youtubeWorkerUrl);
  const channel = normalizeKickChannel(kickChannel);

  if (!workerBase || !channel) return [];

  const badges = normalizeKickBadgeArray(identity?.badges);
  const badgesV2 = normalizeKickBadgeArray(
    identity?.badges_v2 || identity?.badgesV2
  ).filter(
    badge =>
      badge?.selected === undefined ||
      badge?.selected === null ||
      badge?.selected === true
  );

  const cacheKey = JSON.stringify({
    channel,
    badges,
    badgesV2
  });

  const now = Date.now();
  const cached = kickBadgeResolutionCache.get(cacheKey);

  if (
    cached &&
    now - cached.savedAt < KICK_BADGE_RESOLUTION_CACHE_MS
  ) {
    return cached.value;
  }

  if (kickBadgeResolutionLoading.has(cacheKey)) {
    return kickBadgeResolutionLoading.get(cacheKey);
  }

  const loading = (async () => {
    try {
      const endpoint = new URL(
        `${workerBase}/kick/chat-badges`
      );

      endpoint.searchParams.set("channel", channel);
      endpoint.searchParams.set("resolverVersion", "5");
      endpoint.searchParams.set(
        "badges",
        JSON.stringify(badges)
      );
      endpoint.searchParams.set(
        "badgesV2",
        JSON.stringify(badgesV2)
      );

      const response = await fetch(endpoint.toString(), {
        method: "GET",
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error(
          `Kick badge Worker returned HTTP ${response.status}`
        );
      }

      const data = await response.json();

      if (!data?.success) {
        throw new Error(
          data?.error ||
          "Kick badge Worker returned an unsuccessful response."
        );
      }

      const value = normalizeKickBadgeArray(
        data?.resolvedBadges
      ).filter(badge =>
        Boolean(
          String(
            badge?.imageUrl ||
            badge?.image_url ||
            badge?.url ||
            ""
          ).trim()
        ) ||
        Boolean(
          sanitizeKickBadgeSvg(
            badge?.imageSvg ||
            badge?.image_svg ||
            ""
          )
        )
      );

      if (badges.length > 0 && value.length === 0) {
        debugWarn(
          "Kick badge Worker returned no rendered badges.",
          {
            sentLegacyBadges: badges,
            sentBadgesV2: badgesV2,
            response: data
          }
        );
      }

      kickBadgeResolutionCache.set(cacheKey, {
        value,
        savedAt: Date.now()
      });

      return value;
    } catch (error) {
      debugError("Kick badge Worker lookup failed:", error);

      /*
       * Preserve only official URLs already present in the live payload.
       * Do not fall back to hardcoded/local badge images.
       */
      return badgesV2
        .map(badge => ({
          type:
            badge?.badge_type ||
            badge?.badgeType ||
            badge?.type ||
            badge?.name ||
            "",
          text:
            badge?.text ||
            badge?.title ||
            badge?.name ||
            "Kick badge",
          imageUrl:
            badge?.image_url ||
            badge?.imageUrl ||
            badge?.url ||
            "",
          sortOrder:
            badge?.sort_order ??
            badge?.sortOrder ??
            999
        }))
        .filter(badge => badge.imageUrl)
        .sort((a, b) => a.sortOrder - b.sortOrder);
    } finally {
      kickBadgeResolutionLoading.delete(cacheKey);
    }
  })();

  kickBadgeResolutionLoading.set(cacheKey, loading);
  return loading;
}

function parseNativeEmoji(text) {
  const originalText = String(text || "");

  if (!window.twemoji || typeof window.twemoji.parse !== "function") {
    debugWarn("Emoji parser unavailable; using native Unicode.");
    return escapeHTML(originalText);
  }

  /*
   * Protect every complete emoji grapheme before Twemoji parses
   * the remaining text. This gives plain and skin-toned emoji the
   * same Fluent image path and prevents Toolkit from shrinking,
   * splitting or dropping text-presentation emoji such as hands.
   */
  const protectedEmoji = [];
  const segmenter = typeof Intl?.Segmenter === "function"
    ? new Intl.Segmenter("en", { granularity: "grapheme" })
    : null;

  function isEmojiGrapheme(grapheme) {
    return (
      /\p{Extended_Pictographic}/u.test(grapheme) ||
      /[\p{Regional_Indicator}]{2}/u.test(grapheme) ||
      /[0-9#*]\uFE0F?\u20E3/u.test(grapheme)
    );
  }

  function protectEmoji(grapheme) {
    /*
     * Fluent's Unicode mirror generally omits FE0F, while Twemoji
     * requires it for some text-default symbols inside ZWJ sequences
     * such as professions. Keep separate filenames for each source.
     */
    const fluentCodepoint = Array.from(grapheme)
      .map(character => character.codePointAt(0).toString(16))
      .filter(value => value !== "fe0f")
      .join("-");

    /*
     * Ask Twemoji's parser for the exact canonical asset filename.
     * This handles FE0F differently for plain symbols, ZWJ emoji,
     * and skin-tone sequences instead of applying one rule to all.
     */
    const twemojiIcons = [];
    const twemojiProbe = document.createElement("span");
    twemojiProbe.textContent = grapheme;

    window.twemoji.parse(twemojiProbe, {
      callback(icon) {
        if (icon) twemojiIcons.push(icon);

        return (
          "data:image/gif;base64," +
          "R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        );
      }
    });

    const twemojiCodepoint =
      twemojiIcons
        .sort((a, b) => {
          const aParts = a.split("-").length;
          const bParts = b.split("-").length;

          return bParts - aParts || b.length - a.length;
        })[0] ||
      Array.from(grapheme)
        .map(character => character.codePointAt(0).toString(16))
        .filter(value => value !== "fe0f")
        .join("-");

    const token = `__FLUENT_EMOJI_${protectedEmoji.length}__`;

    protectedEmoji.push({
      token,
      alt: grapheme,
      fluentCodepoint,
      twemojiCodepoint
    });

    return token;
  }

  let protectedText = "";

  if (segmenter) {
    for (const item of segmenter.segment(originalText)) {
      const grapheme = item.segment;

      protectedText += isEmojiGrapheme(grapheme)
        ? protectEmoji(grapheme)
        : grapheme;
    }
  } else {
    /*
     * Older-engine fallback covering pictographic emoji, optional
     * variation selectors and skin tones, ZWJ chains, flags and
     * keycap sequences.
     */
    protectedText = originalText.replace(
      /(?:\p{Extended_Pictographic}\uFE0F?(?:[\u{1F3FB}-\u{1F3FF}])?(?:\u200D\p{Extended_Pictographic}\uFE0F?(?:[\u{1F3FB}-\u{1F3FF}])?)*|[\p{Regional_Indicator}]{2}|[0-9#*]\uFE0F?\u20E3)/gu,
      grapheme => protectEmoji(grapheme)
    );
  }

  const container = document.createElement("span");
  container.textContent = protectedText;

  try {
    /*
     * Parse any uncommon emoji sequences not caught by the grapheme
     * detector while preserving ordinary text.
     */
    window.twemoji.parse(container, {
      className: "emote native-emoji",

      callback(icon) {
        return (
          "https://cdn.jsdelivr.net/gh/shuding/" +
          "fluentui-emoji-unicode@main/assets/" +
          icon +
          "_3d.png"
        );
      }
    });

    container.querySelectorAll("img.native-emoji").forEach(image => {
      image.draggable = false;
      image.loading = "eager";
      image.decoding = "async";

      const codepoint = image.src
        .split("/")
        .pop()
        .replace("_3d.png", "");

      image.dataset.fallback =
        "https://cdn.jsdelivr.net/gh/jdecked/" +
        "twemoji@17.0.3/assets/svg/" +
        codepoint +
        ".svg";

      /*
       * Hold the Fluent URL until this image exists in the final
       * message element, where the fallback listener can be attached
       * before loading begins.
       */
      image.dataset.fluentSrc = image.src;
      image.removeAttribute("src");
    });

    let parsedHTML = container.innerHTML;

    protectedEmoji.forEach(({
      token,
      alt,
      fluentCodepoint,
      twemojiCodepoint
    }) => {
      const fluentSrc =
        "https://cdn.jsdelivr.net/gh/shuding/" +
        "fluentui-emoji-unicode@main/assets/" +
        fluentCodepoint +
        "_3d.png";

      const fallbackSrc =
        "https://cdn.jsdelivr.net/gh/jdecked/" +
        "twemoji@17.0.3/assets/svg/" +
        twemojiCodepoint +
        ".svg";

      const emojiImage = `<img
        draggable="false"
        loading="eager"
        decoding="async"
        class="emote native-emoji"
        alt="${escapeHTML(alt)}"
        data-fluent-src="${fluentSrc}"
        data-fallback="${fallbackSrc}"
      >`;

      parsedHTML = parsedHTML.replace(token, emojiImage);
    });

    return parsedHTML;
  } catch (error) {
    debugError("Fluent Emoji parsing failed:", error);
    return escapeHTML(originalText);
  }
}

function isNativeEmojiOnly(text) {
  const stripped = String(text || "")
    /*
     * Emoji bases, ZWJ characters, variation selectors,
     * skin tones, regional indicators and keycap marks.
     */
    .replace(
      /[\p{Extended_Pictographic}\p{Emoji_Modifier}\p{Regional_Indicator}\uFE0F\u200D\u20E3]/gu,
      ""
    )
    .replace(/[\s\p{P}\p{S}\d#*]/gu, "");

  return stripped.length === 0;
}

function safeCSSValue(value) {
  return String(value || "")
    .replaceAll(";", "")
    .replaceAll("{", "")
    .replaceAll("}", "")
    .replaceAll("<", "")
    .replaceAll(">", "");
}

function clampNumber(value, min, max, fallback) {
  const number = Number(value);
  if (!Number.isFinite(number)) return fallback;
  return Math.min(max, Math.max(min, number));
}

function shadowColorToRgba(color, opacity) {
  const clean = String(color || "#000000").trim();
  const alpha = clampNumber(opacity, 0, 1, 0.85);

  const shortHex = clean.match(/^#([0-9a-fA-F]{3})$/);
  if (shortHex) {
    const hex = shortHex[1];
    const r = parseInt(hex[0] + hex[0], 16);
    const g = parseInt(hex[1] + hex[1], 16);
    const b = parseInt(hex[2] + hex[2], 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  const fullHex = clean.match(/^#([0-9a-fA-F]{6})$/);
  if (fullHex) {
    const hex = fullHex[1];
    const r = parseInt(hex.slice(0, 2), 16);
    const g = parseInt(hex.slice(2, 4), 16);
    const b = parseInt(hex.slice(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  // StreamElements' color picker normally returns hex.
  // Fall back safely to black if anything unexpected reaches this field.
  return `rgba(0, 0, 0, ${alpha})`;
}


function normalize7TVColor(color) {
  if (color === null || color === undefined) return "";

  if (typeof color === "string") {
    const str = color.trim();

    if (str.startsWith("#")) return str;

    if (/^[0-9a-fA-F]{6}$/.test(str)) {
      return "#" + str;
    }

    if (!/^-?\d+$/.test(str)) {
      return safeCSSValue(str);
    }

    color = Number(str);
  }

  // 7TV numeric cosmetic colors are packed as RRGGBBAA.
  const num = Number(color) >>> 0;
  const r = (num >>> 24) & 0xff;
  const g = (num >>> 16) & 0xff;
  const b = (num >>> 8) & 0xff;
  const a = num & 0xff;

  return `rgba(${r}, ${g}, ${b}, ${(a / 255).toFixed(4)})`;
}
