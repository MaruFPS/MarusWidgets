const fallbackUsernameColorCache = {};

function isMissingOrWhiteNameColor(color) {
  const normalized = String(color || "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");

  return (
    !normalized ||
    normalized === "white" ||
    normalized === "#fff" ||
    normalized === "#ffffff" ||
    normalized === "#ffffffff" ||
    normalized === "rgb(255,255,255)" ||
    normalized === "rgba(255,255,255,1)"
  );
}

function getFallbackUsernameColor(username) {
  const key = String(username || "")
    .trim()
    .replace(/^@/, "")
    .toLowerCase();

  if (fallbackUsernameColorCache[key]) {
    return fallbackUsernameColorCache[key];
  }

  let hash = 0;

  for (let index = 0; index < key.length; index++) {
    hash = ((hash << 5) - hash) + key.charCodeAt(index);
    hash |= 0;
  }

  const paletteIndex =
    (hash >>> 0) % TWITCH_FALLBACK_NAME_COLORS.length;

  const color = TWITCH_FALLBACK_NAME_COLORS[paletteIndex];
  fallbackUsernameColorCache[key] = color;

  return color;
}

function resolveUsernameColor(username, color) {
  return isMissingOrWhiteNameColor(color)
    ? getFallbackUsernameColor(username)
    : safeCSSValue(color);
}

function getYouTubeUsernameColor(channelId, username) {
  const seed = String(channelId || username || "").trim();

  let hash = 0;

  for (let i = 0; i < seed.length; i++) {
    hash = seed.charCodeAt(i) + ((hash << 5) - hash);
    hash |= 0;
  }

  const hue = Math.abs(hash % 360);

  return `hsl(${hue}, 70%, 60%)`;
}

