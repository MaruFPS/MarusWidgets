  let replyMessage =
    tags["reply-parent-msg-body"] ||
    tags["reply-parent-message-body"] ||
    tags["reply-parent-body"] ||
    data.replyParentMsgBody ||
    data.replyParentMessageBody ||
    "";

  if (!replyUser || !replyMessage) return "";

  replyMessage = String(replyMessage)
    .replace(/\\s/g, " ")
    .replace(/^@\w+\s*/i, "")
