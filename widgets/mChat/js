function scheduleYouTubePoll(delayMs, generation) {
  clearTimeout(youtubePollTimer);

  if (
    !enableYouTubeChat ||
    generation !== youtubePollGeneration
  ) {
    return;
  }

  youtubePollTimer = setTimeout(() => {
    pollYouTubeChat(generation);
  }, Math.max(1000, Number(delayMs) || 5000));
}

function stopYouTubeChat() {
  youtubePollGeneration += 1;
  clearTimeout(youtubePollTimer);
  youtubePollTimer = null;
  youtubePolling = false;
  youtubePageToken = "";
  youtubeCurrentVideoId = "";
  youtubeCurrentLiveChatId = "";
  clearYouTubeMessageHistory();
}

async function pollYouTubeChat(generation) {
  if (
    generation !== youtubePollGeneration ||
    youtubePolling ||
    !enableYouTubeChat
  ) {
    return;
  }

  if (!isValidYouTubeChannelInput(youtubeChannelId)) {
    debugWarn(
      "YouTube chat enabled, but the channel handle, URL or ID is missing or invalid."
    );
    scheduleYouTubePoll(
      youtubeOfflineCheckSeconds * 1000,
      generation
    );
    return;
  }

  const workerBase = cleanYouTubeWorkerUrl(youtubeWorkerUrl);

  if (!workerBase) {
    debugWarn(
      "YouTube chat enabled, but the Worker URL is empty."
    );
    scheduleYouTubePoll(
      youtubeOfflineCheckSeconds * 1000,
      generation
    );
    return;
  }

  youtubePolling = true;

  try {
    const endpoint = new URL(
      `${workerBase}/youtube/chat/updates`
    );

    /*
     * Discovery only happens when the widget has no active liveChatId.
     * After discovery, every poll uses the quota-saving fast path.
     */
    if (youtubeCurrentLiveChatId) {
      endpoint.searchParams.set(
        "liveChatId",
        youtubeCurrentLiveChatId
      );

      if (youtubeCurrentVideoId) {
        endpoint.searchParams.set(
          "videoId",
          youtubeCurrentVideoId
        );
      }
    } else {
      endpoint.searchParams.set(
        "channel",
        youtubeChannelId
      );
    }

    if (youtubePageToken) {
      endpoint.searchParams.set(
        "pageToken",
        youtubePageToken
      );
    }

    const response = await fetch(endpoint.toString(), {
      method: "GET",
      cache: "no-store"
    });

    if (!response.ok) {
      const errorText = await response.text();

      throw new Error(
        `YouTube Worker returned HTTP ${response.status}: ${errorText}`
      );
    }

    const data = await response.json();

    if (generation !== youtubePollGeneration) return;

    if (!data?.success) {
      throw new Error(
        data?.error || "YouTube Worker returned an unsuccessful response."
      );
    }

    if (!data.live) {
      youtubePageToken = "";
      youtubeCurrentVideoId = "";
      youtubeCurrentLiveChatId = "";
      clearYouTubeMessageHistory();

      scheduleYouTubePoll(
        Number(data.shouldPollAfterMillis) ||
          youtubeOfflineCheckSeconds * 1000,
        generation
      );

      return;
    }

    const returnedVideoId = String(data.videoId || "");
    const returnedLiveChatId = String(data.liveChatId || "");

    if (
      youtubeCurrentVideoId &&
      returnedVideoId &&
      returnedVideoId !== youtubeCurrentVideoId
    ) {
      youtubePageToken = "";
      youtubeCurrentLiveChatId = "";
      clearYouTubeMessageHistory();
    }

    youtubeCurrentVideoId =
      returnedVideoId || youtubeCurrentVideoId;

    youtubeCurrentLiveChatId =
      returnedLiveChatId || youtubeCurrentLiveChatId;

    /*
     * The first call has no page token. The Worker intentionally skips the
     * existing backlog and returns the starting cursor. Every later call
     * returns only messages after the token sent by this widget.
     */
    const messages = Array.isArray(data.messages)
      ? data.messages
      : [];

    messages.forEach(handleYouTubeMessage);

    youtubePageToken = String(
      data.nextPageToken || youtubePageToken || ""
    );

    scheduleYouTubePoll(
      Number(data.shouldPollAfterMillis) ||
        Number(data.pollingIntervalMillis) ||
        5000,
      generation
    );
  } catch (error) {
    if (generation !== youtubePollGeneration) return;

    const errorMessage = String(
      error?.message || error || ""
    );

    debugError("YouTube chat poll failed:", error);

    /*
     * If a live chat expires or ends, clear the fast-path IDs so the next
     * attempt returns to handle-based discovery automatically.
     */
    if (
      /liveChatEnded|liveChatNotFound|forbidden|404|403/i.test(
        errorMessage
      )
    ) {
      youtubePageToken = "";
      youtubeCurrentVideoId = "";
      youtubeCurrentLiveChatId = "";
      clearYouTubeMessageHistory();
    }

    scheduleYouTubePoll(
      youtubeOfflineCheckSeconds * 1000,
      generation
    );
  } finally {
    youtubePolling = false;
  }
}

function startYouTubeChat() {
  stopYouTubeChat();

  if (!enableYouTubeChat) {
    debugLog("YouTube chat is disabled.");
    return;
  }

  const generation = youtubePollGeneration;
  pollYouTubeChat(generation);
}


async function fetchKickChannelData(channel) {
  const endpoints = [
    `https://kick.com/api/v2/channels/${encodeURIComponent(channel)}`,
    `https://kick.com/api/v1/channels/${encodeURIComponent(channel)}`
  ];

  let lastError = null;

  for (const endpoint of endpoints) {
    try {
      const response = await fetch(endpoint, {
        method: "GET",
        headers: {
          Accept: "application/json"
        },
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error(`Kick channel lookup returned HTTP ${response.status}`);
      }

      const data = await response.json();
      const chatroomId =
        data?.chatroom?.id ||
        data?.chatroom_id ||
        data?.id;

      if (chatroomId) {
        const channelEmoteSources = [
          data?.emotes,
          data?.chatroom?.emotes,
          data?.livestream?.emotes,
          data?.channel?.emotes
        ];

        kickChannelEmotes = {};

        channelEmoteSources.forEach(source => {
          const list = Array.isArray(source)
            ? source
            : Object.values(source || {});

          list.forEach(emote => {
            const id =
              emote?.id ||
              emote?.emote_id ||
              emote?.emoteId;

            const name =
              emote?.name ||
              emote?.code ||
              emote?.text;

            if (!id || !name) return;

            kickChannelEmotes[name] = {
              id: String(id),
              name: String(name),
              url:
                emote?.url ||
                emote?.image_url ||
                emote?.imageUrl ||
                emote?.src ||
                `https://files.kick.com/emotes/${id}/fullsize`
            };
          });
        });

        return {
          data,
          channelId: String(
            data?.id ||
            data?.channel_id ||
            data?.channel?.id ||
            ""
          ).trim(),
          chatroomId: String(chatroomId),
          platformUserId: String(
            data?.user_id ||
            data?.user?.id ||
            data?.channel?.user_id ||
            data?.channel?.user?.id ||
            ""
          ).trim()
        };
      }

      throw new Error("Kick channel lookup did not include a chatroom ID.");
    } catch (error) {
      lastError = error;
      debugWarn("Kick channel endpoint failed:", endpoint, error);
    }
  }

  throw lastError || new Error("Kick channel lookup failed.");
}

function rememberKickMessageId(messageId) {
  const id = String(messageId || "").trim();

  if (!id) return true;
  if (kickSeenMessageIds.has(id)) return false;

  kickSeenMessageIds.add(id);
  kickSeenMessageOrder.push(id);

  while (kickSeenMessageOrder.length > KICK_SEEN_MESSAGE_LIMIT) {
    const oldest = kickSeenMessageOrder.shift();
    kickSeenMessageIds.delete(oldest);
  }

  return true;
}

function scheduleKickPoll(delayMs, generation) {
  if (!enableKickChat || !kickChannel) return;
  if (generation !== kickConnectionGeneration) return;

  clearTimeout(kickPollTimer);

  kickPollTimer = setTimeout(() => {
    kickPollTimer = null;
    pollKickChat(generation);
  }, Math.max(250, Number(delayMs) || KICK_POLL_MS));
}

function closeKickChat() {
  kickConnectionGeneration += 1;
  clearTimeout(kickPollTimer);
  kickPollTimer = null;
  kickPolling = false;
  kickResolvedChannelId = "";
  kickMessagesInitialized = false;
  kickSeenMessageIds.clear();
  kickSeenMessageOrder.length = 0;
}

async function pollKickChat(generation) {
  if (
    generation !== kickConnectionGeneration ||
    kickPolling ||
    !enableKickChat ||
    !kickChannel
  ) {
    return;
  }

  const workerBase = cleanYouTubeWorkerUrl(youtubeWorkerUrl);

  if (!workerBase) {
    debugWarn(
      "Kick chat enabled, but the shared Worker URL is empty."
    );
    scheduleKickPoll(
      kickReconnectDelaySeconds * 1000,
      generation
    );
    return;
  }

  kickPolling = true;

  try {
    const endpoint = new URL(
      `${workerBase}/kick/chat/updates`
    );

    endpoint.searchParams.set("channel", kickChannel);
    endpoint.searchParams.set(
      "_maru",
      `${Date.now()}-${Math.random().toString(36).slice(2)}`
    );

    const response = await fetch(endpoint.toString(), {
      method: "GET",
      cache: "no-store"
    });

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(
        `Kick Worker returned HTTP ${response.status}: ${errorText}`
      );
    }

    const data = await response.json();

    if (generation !== kickConnectionGeneration) return;

    if (!data?.success) {
      throw new Error(
        data?.error || "Kick Worker returned an unsuccessful response."
      );
    }

    kickResolvedChannelId = String(
      data.channelId || kickResolvedChannelId || ""
    );

    if (!kickSevenTVPlatformId && data.platformUserId) {
      kickSevenTVPlatformId = String(data.platformUserId);
      reloadNativeSevenTVEmotes().catch(error => {
        debugError("Kick 7TV auto-discovery reload failed:", error);
      });
    }

    const messages = Array.isArray(data.messages)
      ? data.messages
      : [];

    const orderedMessages = messages
      .slice()
      .sort((a, b) => {
        const aTime = Date.parse(a?.created_at || a?.createdAt || "") || 0;
        const bTime = Date.parse(b?.created_at || b?.createdAt || "") || 0;
        return aTime - bTime;
      });

    if (!kickMessagesInitialized) {
      orderedMessages.forEach(message => {
        rememberKickMessageId(
          message?.id ||
          message?.message_id ||
          message?.messageId
        );
      });

      kickMessagesInitialized = true;
      debugLog(
        `Kick chat initialized through Worker for ${kickChannel}; ${orderedMessages.length} existing message IDs skipped.`
      );
    } else {
      orderedMessages.forEach(message => {
        const messageId =
          message?.id ||
          message?.message_id ||
          message?.messageId ||
          `${message?.created_at || ""}:${message?.sender?.id || ""}:${message?.content || ""}`;

        if (!rememberKickMessageId(messageId)) return;
        handleKickChatMessage(message);
      });
    }

    scheduleKickPoll(KICK_POLL_MS, generation);
  } catch (error) {
    if (generation !== kickConnectionGeneration) return;

    debugError("Kick chat Worker poll failed:", error);
    scheduleKickPoll(
      kickReconnectDelaySeconds * 1000,
      generation
    );
  } finally {
    kickPolling = false;
  }
}

