function getPaintStyle(paint) {
  if (!paint) {
    return {
      style: "",
      canClipText: false
    };
  }

  let style = "";
  let canClipText = false;

  const paintFunction = String(paint.function || "").toUpperCase();
  const rawAngle = Number(paint.angle);
  const angle = Number.isFinite(rawAngle) ? rawAngle : 0;

  if (paint.image_url) {
    style += `background-image:url('${escapeHTML(paint.image_url)}');`;
    style += "background-size:100% 100%;";
    style += `background-repeat:${paint.repeat ? "repeat" : "no-repeat"};`;
    style += "background-position:left center;";
    canClipText = true;
  } else if (Array.isArray(paint.stops) && paint.stops.length) {
    const stops = paint.stops
      .map(stop => {
        const color = normalize7TVColor(stop.color);
        const rawAt = Number(stop.at);
        const at = rawAt <= 1 ? rawAt * 100 : rawAt;
        return `${color} ${at}%`;
      })
      .join(", ");

    if (paintFunction.includes("RADIAL")) {
      style += `background-image:radial-gradient(circle, ${stops});`;
    } else if (paintFunction.includes("CONIC")) {
      style += `background-image:conic-gradient(from ${angle}deg, ${stops});`;
    } else {
      style += `background-image:linear-gradient(${angle}deg, ${stops});`;
    }

    style += "background-size:100% 100%;";
    style += "background-position:left center;";
    style += "background-repeat:repeat;";
    canClipText = true;
  } else if (paint.color) {
    const color = normalize7TVColor(paint.color);
    style += `color:${color} !important;`;
    style += `-webkit-text-fill-color:${color} !important;`;
  }

  if (paint.shadows?.length) {
    const filterString = paint.shadows
      .map(shadow => {
        const color = normalize7TVColor(shadow.color);

        return `drop-shadow(${shadow.x_offset || 0}px ${
          shadow.y_offset || 0
        }px ${shadow.radius || 0}px ${color})`;
      })
      .join(" ");

    style += `filter:${filterString} !important;`;
  } else {
    style += "filter:none !important;";
  }

  style += "text-shadow:none !important;";

  return {
    style,
    canClipText
  };
}

function fadeAndRemoveMessage(
  element,
  durationMs,
  { force = false } = {}
) {
  if (!element) return;

  /*
   * A message's normal lifetime fade marks it as `removing` for the ENTIRE
   * fade duration. Moderation must be allowed to interrupt that long fade.
   * Otherwise Clear Chat can correctly arrive from EventSub but visibly do
   * nothing until the original lifetime animation eventually finishes.
   */
  if (element.dataset.removing === "true" && !force) return;

  const duration = Math.max(0, Number(durationMs) || 0);
  const currentOpacity = force
    ? Math.max(
        0,
        Math.min(
          1,
          Number.parseFloat(getComputedStyle(element).opacity) || 1
        )
      )
    : 1;

  element.dataset.removing = "true";

  /*
   * Cancel any entrance/lifetime fade before a forced moderation removal so
   * the moderation animation becomes authoritative immediately.
   */
  element.getAnimations().forEach(animation => animation.cancel());

  if (duration === 0) {
    element.remove();
    return;
  }

  const fadeAnimation = element.animate(
    [
      { opacity: currentOpacity },
      { opacity: 0 }
    ],
    {
      duration,
      easing: "linear",
      fill: "forwards"
    }
  );

  fadeAnimation.addEventListener("finish", () => {
    if (element.parentNode === chatContainer) {
      element.remove();
    }
  }, { once: true });
}

function syncProfilePictureBadgeSpacing(messageEl) {
  const holder = messageEl?.querySelector?.(".badges");
  const profilePictureEl = holder?.querySelector?.(".profile-picture");
  if (!holder || !profilePictureEl) return;

  const children = Array.from(holder.children);
  const profileIndex = children.indexOf(profilePictureEl);
  const hasBadgeAfterProfile = children
    .slice(profileIndex + 1)
    .some(element => element.classList?.contains("badge"));

  /*
   * The flex gap belongs to badge-to-badge spacing. Compensate for that gap
   * on the PFP itself so this field controls the TOTAL PFP -> first-badge
   * distance independently, including values smaller than badgeSpacing.
   */
  const adjustment = hasBadgeAfterProfile
    ? profilePictureBadgeSpacing - badgeSpacing
    : 0;

  profilePictureEl.style.setProperty("margin-right", `${adjustment}px`, "important");
}

async function addMessage({
  platform = "twitch",
  username,
  message,
  badges = [],
  badgeHTML = "",
  sevenTVBadge = "",
  profilePicture = "",
  emotes = [],
  nameColor = "#ffffff",
  replyTo = "",
  firstMessage = false,
  paintData = null,
  renderedText = "",
  sharedChat = null,
  gifData = "",
  messageId = "",
  userId = "",
  messageReceivedAt = Date.now()
}) {
  if (!username || (!message && !gifData)) return;
  if (isBot(username)) return;

  await twemojiReady;

  const messageEl = document.createElement("div");

  messageEl.className = fadeMessages === "on"
    ? "chat-message"
    : "chat-message no-fade";

  messageEl.dataset.platform = String(platform || "");
  messageEl.dataset.receivedAt = String(
    Math.max(0, Number(messageReceivedAt) || Date.now())
  );

  if (messageId) {
    messageEl.dataset.messageId = String(messageId);
  }

  if (userId) {
    messageEl.dataset.userId = String(userId);
  }

  if (replyTo) {
    messageEl.classList.add("has-reply");
  }

  if (!showMessageBoxes) {
    messageEl.classList.add("no-box");
  }

  if (highlightFirstMessage && firstMessage) {
    messageEl.classList.add("first-message");
  }

  if (sharedChat?.belongsToSharedSession) {
    messageEl.classList.add("shared-chat-message");
    messageEl.dataset.sourceRoomId = String(
      sharedChat.sourceRoomId || ""
    );
  }

  const safeNameColor = resolveUsernameColor(username, nameColor);
  const creatorSettings = getBadgeSettings(username);
  const paintResult = getPaintStyle(paintData);
  const paintStyle = paintResult.style;
  const hasPaintBackground = paintResult.canClipText;
  const twitchGif =
    platform === "twitch"
      ? parseTwitchGifMetadata(gifData)
      : null;

  if (twitchGif) {
    messageEl.classList.add("has-twitch-gif");
    messageEl.dataset.twitchGif = "true";
  }

  /*
   * Never trust StreamElements renderedText here. Toolkit may receive
   * native emoji glyphs or platform-rendered markup that bypasses the
   * Fluent Emoji pipeline. Always parse the original message ourselves.
   */
  const parsedMessage =
    platform === "kick"
      ? parseKickMessage(message, emotes)
      : twitchGif
        ? parseTwitchMessageWithGif(message, emotes, gifData)
        : parseEmotes(message, emotes);

  messageEl.innerHTML = `
    ${
      showReplyIndicator && replyTo
        ? `
          <div class="reply-indicator">
            ↳ ${escapeHTML(replyTo)}
          </div>
        `
        : ""
    }

    <span
      class="badges"
      style="--badge-spacing:${badgeSpacing}px;gap:var(--badge-spacing);"
    >
      ${
        getPlatformIcon(platform)
          ? `<img
              class="platform-icon platform-${escapeHTML(platform)}"
              src="${escapeHTML(getPlatformIcon(platform))}"
              title="${escapeHTML(
                platform === "kick"
                  ? "Kick"
                  : platform === "youtube"
                    ? "YouTube"
                    : "Twitch"
              )}"
            >`
          : ""
      }

      ${
        enableTwitchSharedChatLabels &&
        platform === "twitch" &&
        sharedChat?.belongsToSharedSession &&
        sharedChat.iconUrl
          ? `<img
              class="shared-chat-source-pfp"
              src="${escapeHTML(sharedChat.iconUrl)}"
              alt="${escapeHTML(sharedChat.label || "Shared Chat")}"
              title="${escapeHTML(
                `Sent in ${sharedChat.label || "Shared Chat"}`
              )}"
            >`
          : ""
      }

      ${
        creatorSettings.showProfilePictures
          ? (profilePicture
              ? `<img
                  class="profile-picture"
                  src="${escapeHTML(profilePicture)}"
                  title="${escapeHTML(username)}"
                >`
              : `<img
                  class="profile-picture"
                  src="${getFallbackProfilePicture(username, safeNameColor)}"
                  title="${escapeHTML(username)}"
                >`)
          : ""
      }

      ${buildVisibleBadgeHTML({ username, sevenTVBadge, badges, badgeHTML })}
    </span><span
      class="username-wrap"
      style="color:${escapeHTML(safeNameColor)};"
    ><span class="username-text"><span
        class="username-base"
        style="${
          hasPaintBackground
            ? "color:transparent !important;-webkit-text-fill-color:transparent !important;"
            : ""
        }"
      >${escapeHTML(username)}</span>${
        hasPaintBackground
          ? `<span
              class="username-paint"
              style="${paintStyle}"
            >${escapeHTML(username)}</span>`
          : ""
      }</span><span class="username-separator">${escapeHTML(usernameSeparator)}</span></span>

    <span class="message-text">
      ${parsedMessage}
    </span>
  `;

  syncProfilePictureBadgeSpacing(messageEl);

  /*
   * A 7TV custom avatar should never leave a broken-image icon in the overlay.
   * If the remote avatar cannot be decoded/loaded, fall back to the widget's
   * existing deterministic profile icon. Animated GIF/WebP/AVIF sources stay
   * untouched and animate natively when they load successfully.
   */
  const profilePictureEl = messageEl.querySelector("img.profile-picture");
  if (profilePictureEl) {
    const fallbackProfilePicture = getFallbackProfilePicture(
      username,
      safeNameColor
    );

    profilePictureEl.addEventListener("error", function handleProfilePictureError() {
      if (this.src === fallbackProfilePicture) return;
      this.src = fallbackProfilePicture;
    });
  }

  const messageTextEl = messageEl.querySelector(".message-text");

  /*
   * Attach Fluent-to-Twemoji fallbacks after the parsed HTML has been
   * inserted into the real message element. Event listeners attached
   * inside parseNativeEmoji() would be lost when container.innerHTML
   * is copied into messageEl.
   */
  messageTextEl
    ?.querySelectorAll(
      "img.native-emoji[data-fluent-src][data-fallback]"
    )
    .forEach(image => {
      image.addEventListener(
        "error",
        function handleFluentError() {
          const fallback = this.dataset.fallback;

          if (fallback && this.src !== fallback) {
            debugWarn(
              "Fluent asset missing; using Twemoji fallback:",
              this.alt
            );

            this.src = fallback;
          }
        },
        { once: true }
      );

      /*
       * Begin loading only after the fallback listener exists.
       */
      image.src = image.dataset.fluentSrc;
    });

  /* Apply the user-selected proportional Twitch GIPHY size after the image loads. */
  wireTwitchGifSizing(messageTextEl);

  const emoteImgs = messageTextEl?.querySelectorAll("img.emote") || [];
  const leftoverText = (messageTextEl?.textContent || "")
    .replace(/\s+/g, "")
    .trim();

  const isActuallyEmoteOnly =
    showEmotePop &&
    emoteImgs.length > 0 &&
    leftoverText.length === 0;

  if (isActuallyEmoteOnly) {
    messageEl.classList.add("emote-pop");
  }

  if (isNativeEmojiOnly(message) && emoteImgs.length > 0) {
    messageEl.classList.add("native-emoji-only");
  }

  chatContainer.appendChild(messageEl);

  /*
   * Live testing proved StreamElements Clear Chat can fail to emit a usable
   * moderation wake-up even with ordinary text-only Twitch messages. Start the
   * EventSub safety poll whenever ANY Twitch message reaches the DOM.
   */
  if (platform === "twitch") {
    syncTwitchModerationActivePolling();
  }

  /*
   * Run the actual fade from JavaScript instead of relying on a delayed
   * CSS animation. OBS/StreamElements browser sources can skip delayed
   * CSS animation frames when the element is removed by a timer.
   */
  if (fadeMessages === "on") {
    setTimeout(() => {
      fadeAndRemoveMessage(messageEl, messageLifetimeSeconds * 1000);
    }, fadeDelaySeconds * 1000);
  }

  const excessMessages = chatContainer.children.length - maxMessages;

  if (excessMessages > 0) {
    const removableMessages = Array.from(chatContainer.children)
      .filter(element => element.dataset.removing !== "true")
      .slice(0, excessMessages);

    removableMessages.forEach(element => {
      fadeAndRemoveMessage(element, 500);
    });
  }

  if (platform === "twitch") {
    const chatterinoReady = attachChatterinoBadge(messageEl, username, userId);
    void attachFFZBadges(messageEl, username, userId, chatterinoReady);
  }
}

function getRenderedTwitchMessages() {
  return Array.from(
    chatContainer.querySelectorAll('.chat-message[data-platform="twitch"]')
  );
}

function hasRenderedTwitchMessages() {
  /*
   * `dataset.removing` does NOT mean the element has left the DOM. Keep polling
   * while at least one Twitch message is actually connected so an EventSub clear
   * can force-interrupt normal lifetime fades too.
   */
  return getRenderedTwitchMessages().some(element => element.isConnected);
}

function stopTwitchModerationActivePolling() {
  if (!twitchModerationActivePollTimer) return;

  clearInterval(twitchModerationActivePollTimer);
  twitchModerationActivePollTimer = null;

  debugLog("Stopped Twitch EventSub active-message polling.");
}

function syncTwitchModerationActivePolling() {
  if (!hasRenderedTwitchMessages()) {
    stopTwitchModerationActivePolling();
    return;
  }

  if (twitchModerationActivePollTimer) return;

  debugLog(
    "Started Twitch EventSub active-message polling because Twitch messages are visible."
  );

  const runPoll = () => {
    if (!hasRenderedTwitchMessages()) {
      stopTwitchModerationActivePolling();
      return;
    }

    if (!twitchModerationFeedReady) {
      fetchTwitchModerationFeed({ bootstrap: true });
      return;
    }

    fetchTwitchModerationFeed();
  };

  /* Check immediately, then once per second only while Twitch chat is visible. */
  runPoll();
  twitchModerationActivePollTimer = setInterval(
    runPoll,
    TWITCH_MODERATION_ACTIVE_POLL_MS
  );
}

function removeRenderedMessages(elements, durationMs = 150) {
  elements.forEach(element => {
    /* Moderation always overrides the normal lifetime fade. */
    fadeAndRemoveMessage(element, durationMs, { force: true });
  });

  /*
   * Give the fade enough time to remove moderated elements, then shut the
   * EventSub poll down automatically if no Twitch messages remain visible.
   */
  setTimeout(
    syncTwitchModerationActivePolling,
    Math.max(0, Number(durationMs) || 0) + 25
  );
}

function removeTwitchMessageById(messageId, sourceLabel = "moderation") {
  const id = String(messageId || "").trim();
  if (!id) return 0;

  const matches = getRenderedTwitchMessages().filter(element =>
    element.dataset.messageId === id
  );

  removeRenderedMessages(matches);

  debugLog(
    `Removed Twitch message after ${sourceLabel}:`,
    id,
    `(${matches.length} overlay match${matches.length === 1 ? "" : "es"})`
  );

  return matches.length;
}

function removeTwitchMessagesByUserId(
  userId,
  sourceLabel = "moderation",
  cutoffMs = Infinity
) {
  const id = String(userId || "").trim();
  if (!id) return 0;

  const cutoff = Number(cutoffMs);
  const matches = getRenderedTwitchMessages().filter(element => {
    if (element.dataset.userId !== id) return false;

    const receivedAt = Number(element.dataset.receivedAt || 0);
    return !Number.isFinite(cutoff) || receivedAt <= cutoff;
  });

  removeRenderedMessages(matches);

  debugLog(
    `Removed Twitch messages after ${sourceLabel}:`,
    id,
    `(${matches.length} overlay match${matches.length === 1 ? "" : "es"})`
  );

  return matches.length;
}

function clearRenderedTwitchMessages(
  sourceLabel = "moderation",
  cutoffMs = Infinity
) {
  const cutoff = Number(cutoffMs);
  const twitchMessages = getRenderedTwitchMessages().filter(element => {
    const receivedAt = Number(element.dataset.receivedAt || 0);
    return !Number.isFinite(cutoff) || receivedAt <= cutoff;
  });

  removeRenderedMessages(twitchMessages);

  debugLog(
    `Cleared visible Twitch overlay messages after ${sourceLabel}.`,
    `(${twitchMessages.length} message${twitchMessages.length === 1 ? "" : "s"})`
  );

  return twitchMessages.length;
}

function rememberTwitchModerationEventId(eventId) {
  const id = String(eventId || "").trim();
  if (!id) return true;
  if (twitchModerationSeenEventIds.has(id)) return false;

  twitchModerationSeenEventIds.add(id);
  twitchModerationSeenEventOrder.push(id);

  while (twitchModerationSeenEventOrder.length > TWITCH_MODERATION_SEEN_LIMIT) {
    const oldest = twitchModerationSeenEventOrder.shift();
    if (oldest) twitchModerationSeenEventIds.delete(oldest);
  }

  return true;
}

function applyTwitchModerationWorkerEvent(event = {}) {
  if (!rememberTwitchModerationEventId(event?.id)) return false;

  const action = String(event?.action || "").trim();

  if (action === "delete-message") {
    const messageId = firstNonEmptyValue(
      event?.messageId,
      event?.messageID,
      event?.message_id
    );

    if (!messageId) {
      debugWarn("Twitch EventSub delete-message arrived without messageId.");
      return false;
    }

    removeTwitchMessageById(messageId, "Twitch EventSub delete");
    return true;
  }

  if (action === "clear-user-messages") {
    const userId = firstNonEmptyValue(
      event?.targetUserId,
      event?.userId,
      event?.user_id
    );

    if (!userId) {
      debugWarn("Twitch EventSub clear-user-messages arrived without targetUserId.");
      return false;
    }

    const eventCutoff = Number(event?.receivedAt || 0) || Infinity;

    removeTwitchMessagesByUserId(
      userId,
      "Twitch EventSub timeout/ban",
      eventCutoff
    );
    return true;
  }

  if (action === "clear-chat") {
    /*
     * If EventSub delivery/reconciliation is delayed, never let an OLD Clear
     * Chat wipe messages that arrived after that clear happened. This is what
     * made deleting a later GIF appear to clear the entire widget in v1.6.
     */
    const eventCutoff = Number(event?.receivedAt || 0) || Infinity;

    clearRenderedTwitchMessages(
      "Twitch EventSub Clear Chat",
      eventCutoff
    );
    return true;
  }

  debugWarn("Unknown Twitch moderation Worker event:", event);
  return false;
}

function buildTwitchModerationFeedEndpoint(after = twitchModerationCursor) {
  const workerBase = cleanYouTubeWorkerUrl(youtubeWorkerUrl);
  if (!workerBase) return null;

  const endpoint = new URL(`${workerBase}/twitch/moderation/feed`);

  if (twitchModerationBroadcasterId) {
    endpoint.searchParams.set("broadcasterId", twitchModerationBroadcasterId);
  } else if (twitchModerationChannel) {
    endpoint.searchParams.set("channel", twitchModerationChannel);
  } else {
    return null;
  }

  endpoint.searchParams.set("after", String(Math.max(0, Number(after) || 0)));
  return endpoint;
}

async function fetchTwitchModerationFeed({ bootstrap = false } = {}) {
  if (twitchModerationFetchPromise) {
    return twitchModerationFetchPromise;
  }

  const endpoint = buildTwitchModerationFeedEndpoint(
    bootstrap ? 0 : twitchModerationCursor
  );

  if (!endpoint) return null;

  twitchModerationFetchPromise = (async () => {
    try {
      const response = await fetch(endpoint.toString(), {
        cache: "no-store",
        headers: {
          Accept: "application/json"
        }
      });

      const text = await response.text();
      let data = null;

      try {
        data = JSON.parse(text);
      } catch {
        data = null;
      }

      if (!response.ok || !data?.success) {
        throw new Error(
          data?.error ||
          `Twitch moderation Worker returned HTTP ${response.status}`
        );
      }

      const nextCursor = Math.max(
        twitchModerationCursor,
        Number(data?.cursor || 0)
      );

      if (bootstrap) {
        /*
         * Establish a clean cursor at widget startup. Old moderation events
         * happened before this overlay instance existed and must not replay.
         */
        twitchModerationCursor = nextCursor;
        twitchModerationFeedReady = true;

        debugLog(
          "Twitch moderation feed baseline ready:",
          twitchModerationCursor
        );

        return data;
      }

      const events = Array.isArray(data?.events) ? data.events : [];
      events.forEach(applyTwitchModerationWorkerEvent);

      twitchModerationCursor = nextCursor;
      twitchModerationFeedReady = true;

      return data;
    } catch (error) {
      debugWarn("Twitch moderation Worker feed check failed:", error);
      return null;
    } finally {
      twitchModerationFetchPromise = null;
    }
  })();

  return twitchModerationFetchPromise;
}

function initializeTwitchModerationFeed() {
  stopTwitchModerationActivePolling();
  twitchModerationCursor = 0;
  twitchModerationFeedReady = false;
  twitchModerationReconcileGeneration += 1;

  fetchTwitchModerationFeed({ bootstrap: true }).catch(error => {
    debugWarn("Twitch moderation feed baseline failed:", error);
  });
}

function scheduleTwitchModerationReconcile() {
  const generation = ++twitchModerationReconcileGeneration;

  /*
   * StreamElements tells us that moderation happened; Twitch EventSub tells us
   * exactly WHAT happened. Webhook arrival order is not guaranteed, so make a
   * short, bounded retry burst instead of polling the Worker continuously.
   */
  TWITCH_MODERATION_RECONCILE_DELAYS_MS.forEach(delayMs => {
    setTimeout(() => {
      if (generation !== twitchModerationReconcileGeneration) return;

      if (!twitchModerationFeedReady) {
        fetchTwitchModerationFeed({ bootstrap: true });
        return;
      }

      fetchTwitchModerationFeed();
    }, delayMs);
  });
}

function handleTwitchDeleteMessage(event = {}) {
  const msgId = firstNonEmptyValue(
    event?.msgId,
    event?.messageId,
    event?.messageID,
    event?.data?.msgId,
    event?.data?.messageId,
    event?.data?.messageID
  );

  /*
   * Preserve StreamElements' fast exact-ID path for ordinary messages, then
   * reconcile against EventSub in case this is one of Twitch's newer message
   * types where StreamElements omits or misclassifies moderation metadata.
   */
  if (msgId) {
    removeTwitchMessageById(msgId, "StreamElements delete-message");
  } else {
    debugWarn("Twitch delete-message arrived without a message ID.");
  }

  scheduleTwitchModerationReconcile();
}

function handleTwitchDeleteMessages(event = {}) {
  const userId = firstNonEmptyValue(
    event?.userId,
    event?.userID,
    event?.user_id,
    event?.data?.userId,
    event?.data?.userID,
    event?.data?.user_id
  );

  /*
   * A real timeout/ban with a user ID is safe to apply immediately. Empty
   * delete-messages payloads are intentionally NOT guessed anymore: Twitch
   * EventSub resolves whether it was Clear Chat or a single GIPHY deletion.
   */
  if (userId) {
    removeTwitchMessagesByUserId(userId, "StreamElements timeout/ban");
  } else {
    debugLog(
      "Ambiguous StreamElements delete-messages event received; waiting for Twitch EventSub authority."
    );
  }

  scheduleTwitchModerationReconcile();
}

window.addEventListener("onEventReceived", function (obj) {
  const listener = obj?.detail?.listener;
  const event = obj?.detail?.event;
  const data = event?.data || event;


  if (listener === "delete-message") {
    handleTwitchDeleteMessage(event || {});
    return;
  }

  if (listener === "delete-messages") {
    handleTwitchDeleteMessages(event || {});
    return;
  }

  if (listener !== "message") return;
  if (!data) return;

  /* Capture arrival time BEFORE asynchronous badge/cosmetic lookups. */
  const twitchOverlayReceivedAt = Date.now();

  const username =
    data.displayName ||
    data.nick ||
    data.username ||
    data.name;

  const twitchUserId =
    data.userId ||
    data.userID ||
    data.user_id ||
    data.uid ||
    data.tags?.["user-id"] ||
    data.tags?.userId ||
    data.tags?.user_id ||
    data.raw?.tags?.["user-id"] ||
    "";

  const twitchMessageId =
    data.msgId ||
    data.messageId ||
    data.messageID ||
    data.tags?.id ||
    data.raw?.tags?.id ||
    data.id ||
    "";

  const rawMessage = data.text || data.message || "";
  const replyTo = buildReplyPreview(data);
  const message = cleanReplyMentionFromMessage(rawMessage, replyTo);

  const emotes =
    data.emotes ||
    data["7tvEmotes"] ||
    data.sevenTVEmotes ||
    data.tags?.emotes ||
    [];

  const gifData = readTwitchTag(data, "gifs");

  const sharedChat = getTwitchSharedChatInfo(data);

  if (sharedChat.belongsToSharedSession) {
    debugGroup(
      "Twitch shared-chat inspection",
      {
        roomId: sharedChat.roomId,
        sourceRoomId: sharedChat.sourceRoomId,
        sourceId: sharedChat.sourceId,
        sourceLogin: sharedChat.sourceLogin,
        sourceDisplayName: sharedChat.sourceDisplayName,
        rawSourceBadges: sharedChat.rawSourceBadges,
        sourceBadges: sharedChat.sourceBadges,
        sourceBadgeInfo: sharedChat.sourceBadgeInfo,
        isExternalSource: sharedChat.isExternalSource,
        resolvedLabel: sharedChat.label,
        tags: data.tags || null,
        rawTags: data.raw?.tags || null
      },
      "insane"
    );
  }

  if (
    sharedChat.sourceId &&
    !rememberTwitchSharedSourceId(sharedChat.sourceId)
  ) {
    debugLog(
      "Skipped duplicate Twitch Shared Chat message:",
      sharedChat.sourceId
    );
    return;
  }

  Promise.all([
    loadSevenTVCosmetics(twitchUserId, username),
    loadTwitchSharedSourceFromWorker(sharedChat)
  ]).then(([cosmetics, sharedSource]) => {
    const firstMessage = isFirstMessage(data);

    if (
      sharedChat.belongsToSharedSession &&
      sharedSource?.creator
    ) {
      sharedChat.iconUrl =
        sharedSource.creator.profileImageUrl ||
        sharedChat.iconUrl ||
        "";

      sharedChat.label =
        cleanTwitchSharedSourceLabel(
          sharedSource.creator.displayName
        ) ||
        cleanTwitchSharedSourceLabel(
          sharedSource.creator.login
        ) ||
        cleanTwitchSharedSourceLabel(
          sharedChat.label
        ) ||
        "Shared";
    }

    const normalTwitchBadges = (
      Array.isArray(data.badges)
        ? data.badges
        : Object.values(data.badges || {})
    ).filter(badge => {
      const badgeName = String(
        badge?.name ||
        badge?.type ||
        badge?.badge_type ||
        ""
      );

      const normalized = badgeName
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");

      return (
        normalized !== "deleteduser" &&
        normalized !== "unknownuser" &&
        normalized !== "anonymous"
      );
    });

    const workerSourceBadges =
      sharedChat.belongsToSharedSession &&
      sharedSource?.badges?.length
        ? sharedSource.badges
        : [];

    const twitchBadges =
      workerSourceBadges.length
        ? workerSourceBadges
        : (
            sharedChat.isExternalSource &&
            sharedChat.sourceBadges?.length
              ? sharedChat.sourceBadges
              : normalTwitchBadges
          );

    addMessage({
      platform: "twitch",
      username,
      message,
      badges: twitchBadges,
      sevenTVBadge: cosmetics?.badgeUrl || "",
      profilePicture: cosmetics?.avatarUrl || "",
      emotes,
      nameColor:
        cosmetics?.color ||
        data.displayColor ||
        data.color ||
        "#ffffff",
      replyTo,
      firstMessage,
      paintData: cosmetics?.paintData || null,
      renderedText: event.renderedText || data.renderedText || "",
      sharedChat,
      gifData,
      messageId: twitchMessageId,
      userId: twitchUserId,
      messageReceivedAt: twitchOverlayReceivedAt
    });
  });
});

