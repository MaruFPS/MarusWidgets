function firstNonEmptyValue(...values) {
  for (const value of values) {
    if (value !== undefined && value !== null && String(value).trim() !== "") {
      return value;
    }
  }

  return "";
}

function readTwitchTag(data, ...names) {
  const containers = [
    data,
    data?.tags,
    data?.raw,
    data?.raw?.tags,
    data?.message,
    data?.message?.tags,
    data?.event,
    data?.event?.tags
  ].filter(Boolean);

  for (const container of containers) {
    for (const name of names) {
      const camelName = String(name).replace(
        /-([a-z])/g,
        (_, letter) => letter.toUpperCase()
      );

      const value = firstNonEmptyValue(
        container?.[name],
        container?.[camelName]
      );

      if (value !== "") return String(value).trim();
    }
  }

  return "";
}

function rememberTwitchSharedSourceId(sourceId) {
  const id = String(sourceId || "").trim();

  if (!id) return true;
  if (twitchSharedSeenSourceIds.has(id)) return false;

  twitchSharedSeenSourceIds.add(id);
  twitchSharedSeenSourceOrder.push(id);

  while (twitchSharedSeenSourceOrder.length > TWITCH_SHARED_SEEN_LIMIT) {
    const oldest = twitchSharedSeenSourceOrder.shift();
    twitchSharedSeenSourceIds.delete(oldest);
  }

  return true;
}


const ALLOWED_TWITCH_SOURCE_BADGE_TYPES = new Set([
  "broadcaster",
  "moderator",
  "vip",
  "subscriber",
  "founder",
  "staff",
  "admin",
  "global_mod",
  "verified",
  "partner"
]);

function isAllowedTwitchSourceBadgeType(type) {
  return ALLOWED_TWITCH_SOURCE_BADGE_TYPES.has(
    normalizeBadgeType(type)
  );
}

function normalizeTwitchBadgeCollection(value, fallbackBadges = []) {
  const fallbackList = Array.isArray(fallbackBadges)
    ? fallbackBadges
    : [];

  const matchFallbackBadge = (type, version = "") => {
    const normalizedType = normalizeBadgeType(type);

    if (!isAllowedTwitchSourceBadgeType(normalizedType)) {
      return null;
    }

    return fallbackList.find(badge => {
      const badgeType = normalizeBadgeType(
        badge?.name || badge?.type || ""
      );

      const badgeVersion = String(
        badge?.version ||
        badge?.id ||
        badge?.value ||
        ""
      );

      return (
        badgeType === normalizedType &&
        (
          !version ||
          !badgeVersion ||
          badgeVersion === String(version)
        )
      );
    }) || null;
  };

  const acceptBadgeObject = (badge, fallbackType = "") => {
    if (!badge || typeof badge !== "object") return null;

    const type = normalizeBadgeType(
      badge?.name ||
      badge?.type ||
      badge?.badge_type ||
      fallbackType ||
      ""
    );

    if (!isAllowedTwitchSourceBadgeType(type)) {
      return null;
    }

    const url =
      badge?.url ||
      badge?.image_url ||
      badge?.imageUrl ||
      badge?.src ||
      badge?.icon ||
      "";

    if (url) {
      return {
        ...badge,
        name: badge?.name || type,
        type: badge?.type || type,
        url
      };
    }

    return matchFallbackBadge(
      type,
      badge?.version || badge?.id || badge?.value || ""
    );
  };

  if (!value) return [];

  if (Array.isArray(value)) {
    return value
      .map(badge => acceptBadgeObject(badge))
      .filter(Boolean);
  }

  if (typeof value === "object") {
    return Object.entries(value)
      .map(([type, versionOrBadge]) => {
        if (versionOrBadge && typeof versionOrBadge === "object") {
          return acceptBadgeObject(versionOrBadge, type);
        }

        return matchFallbackBadge(type, versionOrBadge);
      })
      .filter(Boolean);
  }

  return String(value)
    .split(",")
    .map(entry => entry.trim())
    .filter(Boolean)
    .map(entry => {
      const [type, version = ""] = entry.split("/");

      if (!isAllowedTwitchSourceBadgeType(type)) {
        return null;
      }

      return matchFallbackBadge(type, version);
    })
    .filter(Boolean);
}

function getTwitchSourceBadges(data = {}) {
  const rawSourceBadges = firstNonEmptyValue(
    data?.sourceBadges,
    data?.["source-badges"],
    data?.tags?.sourceBadges,
    data?.tags?.["source-badges"],
    data?.raw?.sourceBadges,
    data?.raw?.["source-badges"],
    data?.raw?.tags?.sourceBadges,
    data?.raw?.tags?.["source-badges"]
  );

  return normalizeTwitchBadgeCollection(
    rawSourceBadges,
    data?.badges || []
  );
}


function cleanTwitchSharedSourceLabel(value) {
  const label = String(value || "")
    .trim()
    .replace(/^@/, "");

  if (!label) return "";

  const normalized = label
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "");

  /*
   * StreamElements test events can expose moderation placeholders such as
   * "-DeletedUser" in fields that resemble source-channel metadata.
   * Never show those placeholders as a collaborator/channel label.
   */
  if (
    normalized === "deleteduser" ||
    normalized === "unknownuser" ||
    normalized === "anonymous" ||
    normalized === "null" ||
    normalized === "undefined"
  ) {
    return "";
  }

  if (label.length > 40) return "";

  return label;
}

function getTwitchSharedChatInfo(data = {}) {
  const roomId = readTwitchTag(
    data,
    "room-id",
    "roomId"
  );

  const sourceRoomId = readTwitchTag(
    data,
    "source-room-id",
    "sourceRoomId"
  );

  const sourceId = readTwitchTag(
    data,
    "source-id",
    "sourceId"
  );

  const sourceLogin = readTwitchTag(
    data,
    "source-broadcaster-login",
    "source-broadcaster-signin",
    "source-login",
    "sourceChannel",
    "sourceChannelName"
  );

  const sourceDisplayName = readTwitchTag(
    data,
    "source-broadcaster-display-name",
    "source-display-name",
    "sourceDisplayName"
  );

  const rawSourceBadges = String(
    firstNonEmptyValue(
      data?.sourceBadges,
      data?.["source-badges"],
      data?.tags?.sourceBadges,
      data?.tags?.["source-badges"],
      data?.raw?.sourceBadges,
      data?.raw?.["source-badges"],
      data?.raw?.tags?.sourceBadges,
      data?.raw?.tags?.["source-badges"]
    ) || ""
  ).trim();

  const sourceBadges = getTwitchSourceBadges(data);

  const sourceBadgeInfo = firstNonEmptyValue(
    data?.sourceBadgeInfo,
    data?.["source-badge-info"],
    data?.tags?.sourceBadgeInfo,
    data?.tags?.["source-badge-info"],
    data?.raw?.sourceBadgeInfo,
    data?.raw?.["source-badge-info"],
    data?.raw?.tags?.sourceBadgeInfo,
    data?.raw?.tags?.["source-badge-info"]
  );

  const belongsToSharedSession = Boolean(sourceRoomId);
  const isExternalSource =
    Boolean(sourceRoomId) &&
    Boolean(roomId) &&
    sourceRoomId !== roomId;

  const manualIdMatches =
    Boolean(collaboratorTwitchUserId) &&
    sourceRoomId === collaboratorTwitchUserId;

  const cleanSourceDisplayName =
    cleanTwitchSharedSourceLabel(sourceDisplayName);

  const cleanSourceLogin =
    cleanTwitchSharedSourceLabel(sourceLogin);

  const cleanFallbackUsername =
    cleanTwitchSharedSourceLabel(collaboratorTwitchUsername);

  const label =
    cleanSourceDisplayName ||
    cleanSourceLogin ||
    (
      manualIdMatches || isExternalSource
        ? cleanFallbackUsername
        : ""
    ) ||
    "Shared";

  return {
    roomId,
    sourceRoomId,
    sourceId,
    sourceLogin,
    sourceDisplayName,
    rawSourceBadges,
    sourceBadges,
    sourceBadgeInfo,
    belongsToSharedSession,
    isExternalSource,
    label,
    iconUrl:
      isExternalSource || manualIdMatches
        ? collaboratorTwitchIconUrl
        : ""
  };
}


function normalizeWorkerBadgeResults(badges) {
  if (!Array.isArray(badges)) return [];

  return badges
    .map(badge => {
      const url = String(
        badge?.imageUrl ||
        badge?.image_url ||
        badge?.url ||
        ""
      ).trim();

      if (!url) return null;

      return {
        name: String(badge?.setId || badge?.name || "badge"),
        type: String(badge?.setId || badge?.type || "badge"),
        version: String(badge?.version || ""),
        url,
        title: String(
          badge?.title ||
          badge?.description ||
          badge?.setId ||
          "Twitch badge"
        )
      };
    })
    .filter(Boolean);
}

async function loadTwitchSharedSourceFromWorker(sharedChat) {
  if (
    !sharedChat?.belongsToSharedSession ||
    !/^\d+$/.test(String(sharedChat.sourceRoomId || ""))
  ) {
    return null;
  }

  const workerBase = cleanYouTubeWorkerUrl(youtubeWorkerUrl);
  if (!workerBase) return null;

  const badgeTag = String(sharedChat.rawSourceBadges || "").trim();
  const cacheKey = `${sharedChat.sourceRoomId}|${badgeTag}`;
  const now = Date.now();
  const cached = twitchSharedSourceCache.get(cacheKey);

  if (
    cached &&
    now - cached.savedAt < TWITCH_SHARED_SOURCE_CACHE_MS
  ) {
    return cached.value;
  }

  if (twitchSharedSourceLoading.has(cacheKey)) {
    return twitchSharedSourceLoading.get(cacheKey);
  }

  const loading = (async () => {
    try {
      const endpoint = new URL(
        `${workerBase}/twitch/shared-chat/source`
      );

      endpoint.searchParams.set(
        "roomId",
        String(sharedChat.sourceRoomId)
      );

      if (badgeTag) {
        endpoint.searchParams.set("badges", badgeTag);
      }

      const response = await fetch(endpoint.toString(), {
        method: "GET",
        cache: "no-store"
      });

      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(
          `Shared Chat Worker returned HTTP ${response.status}: ${errorText}`
        );
      }

      const data = await response.json();

      if (!data?.success) {
        throw new Error(
          data?.error ||
          "Shared Chat Worker returned an unsuccessful response."
        );
      }

      const creator = data?.creator || null;
      const value = {
        creator: creator
          ? {
              id: String(creator.id || sharedChat.sourceRoomId),
              login: String(creator.login || ""),
              displayName: String(
                creator.displayName ||
                creator.login ||
                ""
              ),
              profileImageUrl: String(
                creator.profileImageUrl || ""
              )
            }
          : null,
        badges: normalizeWorkerBadgeResults(data?.badges)
      };

      twitchSharedSourceCache.set(cacheKey, {
        value,
        savedAt: Date.now()
      });

      return value;
    } catch (error) {
      debugError(
        "Twitch Shared Chat Worker lookup failed:",
        error
      );
      return null;
    } finally {
      twitchSharedSourceLoading.delete(cacheKey);
    }
  })();

  twitchSharedSourceLoading.set(cacheKey, loading);
  return loading;
}

