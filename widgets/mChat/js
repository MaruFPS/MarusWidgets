    .trim();

  if (!replyMessage) return "";

  const shortMessage =
    replyMessage.length > replyPreviewLength
      ? replyMessage.slice(0, replyPreviewLength) + "..."
      : replyMessage;

  return `${replyUser}: ${shortMessage}`;
}

