function handleKickChatMessage(chatData) {
  const sender = chatData?.sender || {};
  const identity = sender?.identity || chatData?.identity || {};

  const username =
    sender.username ||
    sender.slug ||
    chatData?.username ||
    "";

  if (!username) return;

  const kickUserId =
    sender.id ||
    sender.user_id ||
    sender.userId ||
    sender.uid ||
    chatData?.sender_id ||
    chatData?.user_id ||
    chatData?.userId ||
    "";

  const extracted = extractKickEmotes(
    chatData?.content || chatData?.message || "",
    chatData?.emotes || chatData?.metadata?.emotes || []
  );

  Promise.all([
    loadSevenTVKickCosmetics(kickUserId, username),
    loadKickBadgesFromWorker(identity)
  ]).then(([cosmetics, resolvedKickBadges]) => {
    addMessage({
      platform: "kick",
      username,
      message: extracted.original,
      badges: [],
      badgeHTML: renderResolvedKickBadges(
        resolvedKickBadges,
        username
      ),
      sevenTVBadge: cosmetics?.badgeUrl || "",
      profilePicture:
        cosmetics?.avatarUrl ||
        getKickProfilePicture(sender),
      emotes: extracted.emotes,
      nameColor:
        cosmetics?.color ||
        identity.color ||
        sender.color ||
        "#53FC18",
      replyTo: "",
      firstMessage: false,
      paintData: cosmetics?.paintData || null,
      renderedText: ""
    });
  });
}

async function connectKickChat() {
  closeKickChat();

  if (!enableKickChat) {
    debugLog("Kick chat is disabled.");
    return;
  }

  if (!kickChannel) {
    debugWarn("Kick chat enabled, but no Kick channel was entered.");
    return;
  }

  const generation = kickConnectionGeneration;
  pollKickChat(generation);
}

window.addEventListener("onWidgetLoad", function (obj) {
  const fieldData = obj?.detail?.fieldData || {};

  applyWidgetFields(fieldData);

  // Warm Chatterino's shared badge catalog only when at least one
  // active badge profile can actually render Chatterino badges.
  if (
    (showBadges && showChatterinoBadges) ||
    (enableCreatorBadgeOverrides && creatorShowBadges && creatorShowChatterinoBadges)
  ) {
    void loadChatterinoBadges();
  }

  // Warm FFZ only when an active badge profile can display it.
  if (
    (showBadges && showFFZBadges) ||
    (enableCreatorBadgeOverrides && creatorShowBadges && creatorShowFFZBadges)
  ) {
    void loadFFZBadges();
  }

  twitchModerationChannel = String(
    obj?.detail?.channel?.username ||
    obj?.detail?.channel?.name ||
    ""
  )
    .trim()
    .replace(/^@/, "");

  /*
   * IMPORTANT: StreamElements `channel.id` is not guaranteed to be the
   * Twitch broadcaster ID (it can be StreamElements' own internal channel ID).
   * Using it as ?broadcasterId makes the Worker read the wrong KV feed and
   * silently miss real EventSub events. The documented channel.username is
   * authoritative for this widget, and the Worker resolves/caches the real
   * Twitch broadcaster ID from that login.
   */
  twitchModerationBroadcasterId = "";

  initializeTwitchModerationFeed();

  if (!twitchSevenTVPlatformId) {
    twitchSevenTVPlatformId = String(
      obj?.detail?.channel?.id ||
      obj?.detail?.channel?.userId ||
      obj?.detail?.account?.id ||
      obj?.detail?.account?.userId ||
      ""
    ).trim();
  }

  /*
   * Warm the shared catalog in the background. Chat can load normally
   * while this finishes, and the existing GraphQL behavior remains the
   * fallback foundation for the next 7TV API migration stages.
   */
  loadSevenTVPaintCatalog().catch(error => {
    debugError("7TV paint catalog warm-up failed:", error);
  });

  reloadNativeSevenTVEmotes().catch(error => {
    debugError("Native 7TV emote startup failed:", error);
  });

  debugLog("Starting Kick chat initialization.");
  connectKickChat();

  debugLog("Starting YouTube chat initialization.");
  startYouTubeChat();
});
