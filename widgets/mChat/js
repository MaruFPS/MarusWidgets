function cleanYouTubeWorkerUrl(value) {
  return String(value || "")
    .trim()
    .replace(/\/+$/, "");
}

function isValidYouTubeChannelInput(value) {
  const input = String(value || "").trim();

  if (!input) return false;

  return (
    /^UC[a-zA-Z0-9_-]{20,30}$/.test(input) ||
    /^@[a-zA-Z0-9._-]+$/.test(input) ||
    /^[a-zA-Z0-9._-]+$/.test(input) ||
    /^https?:\/\/(?:www\.)?youtube\.com\/@[a-zA-Z0-9._-]+(?:[/?#].*)?$/i.test(input)
  );
}

function rememberYouTubeMessageId(messageId) {
  const id = String(messageId || "").trim();
  if (!id || youtubeSeenMessageIds.has(id)) return false;

  youtubeSeenMessageIds.add(id);
  youtubeSeenMessageOrder.push(id);

  while (youtubeSeenMessageOrder.length > YOUTUBE_SEEN_MESSAGE_LIMIT) {
    const oldestId = youtubeSeenMessageOrder.shift();
    if (oldestId) youtubeSeenMessageIds.delete(oldestId);
  }

  return true;
}

function clearYouTubeMessageHistory() {
  youtubeSeenMessageIds.clear();
  youtubeSeenMessageOrder.length = 0;
}

function createYouTubeBadgeDataUrl(kind) {
  const badgeMap = {
    owner: {
      background: "#FF0000",
      title: "C",
      label: "YouTube Channel Owner"
    },
    moderator: {
      background: "#5F6368",
      title: "M",
      label: "YouTube Moderator"
    },
    member: {
      background: "#2BA640",
      title: "★",
      label: "YouTube Member"
    },
    verified: {
      background: "#1A73E8",
      title: "✓",
      label: "YouTube Verified"
    }
  };

  const badge = badgeMap[kind];
  if (!badge) return null;

  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">' +
    `<circle cx="12" cy="12" r="11" fill="${badge.background}"/>` +
    `<text x="12" y="16" text-anchor="middle" font-size="13" ` +
    'font-family="Arial,sans-serif" font-weight="700" fill="#fff">' +
    escapeHTML(badge.title) +
    '</text></svg>';

  return {
    url:
      "data:image/svg+xml;charset=UTF-8," +
      encodeURIComponent(svg),
    label: badge.label
  };
}

function renderYouTubeBadges(messageData = {}) {
  const author = messageData?.author || {};
  const badges = messageData?.badges || {};
  const output = [];

  const addBadge = kind => {
    const badge = createYouTubeBadgeDataUrl(kind);
    if (!badge) return;

    output.push(
      `<img class="badge youtube-role-badge youtube-${kind}-badge" ` +
      `src="${escapeHTML(badge.url)}" ` +
      `title="${escapeHTML(badge.label)}">`
    );
  };

  if (author.isOwner || badges.owner) addBadge("owner");
  if (author.isModerator || badges.moderator) addBadge("moderator");
  if (author.isMember || badges.member) addBadge("member");
  if (author.isVerified || badges.verified) addBadge("verified");

  return output.join("");
}

