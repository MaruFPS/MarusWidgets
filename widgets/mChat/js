function renderBadges(badges = [], settings = getBadgeSettings()) {
  if (!settings.showBadges || !badges) return "";

  if (!Array.isArray(badges)) {
    badges = Object.values(badges || {});
  }

  return badges.map(badge => {
    const name = String(badge.name || badge.type || "badge");
    const normalizedName = name.toLowerCase();

    if (!shouldShowBadgeType(normalizedName, settings)) return "";

    const url =
      badge.url ||
      badge.image_url ||
      badge.imageUrl ||
      badge.icon ||
      badge.src;

    if (!url) return "";

    return `<img class="badge" src="${escapeHTML(url)}" title="${escapeHTML(name)}">`;
  }).join("");
}

function splitBadgeHTML(html = "") {
  if (!html) return [];

  const holder = document.createElement("span");
  holder.innerHTML = html;

  /*
   * Keep each top-level badge element intact.
   * Kick role badges are <span class="badge"> wrappers containing inline SVG,
   * while URL-based badges are normal <img class="badge"> elements.
   * The old img-only selector silently discarded every inline SVG badge.
   */
  return Array.from(holder.children)
    .filter(element => element.classList?.contains("badge"))
    .map(element => element.outerHTML);
}

function buildVisibleBadgeHTML({ username = "", sevenTVBadge = "", badges = [], badgeHTML = "", chatterinoBadge = null, ffzBadges = [] }) {
  const settings = getBadgeSettings(username);
  if (!settings.showBadges) return "";

  const badgeItems = [];

  /*
   * Native/platform badge data comes first so a low Max Badges setting
   * cannot let the optional 7TV badge consume the only available slot.
   */
  badgeItems.push(...splitBadgeHTML(renderBadges(badges, settings)));
  badgeItems.push(...splitBadgeHTML(badgeHTML));

  if (settings.showSevenTVBadges && sevenTVBadge) {
    badgeItems.push(`<img
      class="badge seventv-badge"
      src="${escapeHTML(sevenTVBadge)}"
      title="7TV Badge"
    >`);
  }

  if (settings.showChatterinoBadges && chatterinoBadge) {
    badgeItems.push(`<img
      class="badge chatterino-badge"
      src="${escapeHTML(chatterinoBadge.url)}"
      title="${escapeHTML(chatterinoBadge.tooltip)}"
    >`);
  }

  if (settings.showFFZBadges) {
    for (const badge of ffzBadges) {
      badgeItems.push(`<img
        class="badge ffz-badge"
        data-ffz-badge-id="${escapeHTML(badge.id)}"
        src="${escapeHTML(badge.url)}"
        title="${escapeHTML(badge.title)}"
        style="background-color:${escapeHTML(badge.color)};"
      >`);
    }
  }

  return badgeItems.slice(0, settings.maxBadges).join("");
}

/* Chatterino's public catalog maps badges to Twitch user IDs, not names. */
let chatterinoBadgeCache = new Map();
let chatterinoBadgeLoading = null;
let chatterinoBadgeNextFetchAt = 0;
const CHATTERINO_BADGE_CACHE_MS = 6 * 60 * 60 * 1000;
const CHATTERINO_BADGE_RETRY_MS = 5 * 60 * 1000;

function loadChatterinoBadges() {
  if (chatterinoBadgeLoading) return chatterinoBadgeLoading;
  if (Date.now() < chatterinoBadgeNextFetchAt) {
    return Promise.resolve(chatterinoBadgeCache);
  }

  chatterinoBadgeLoading = Promise.resolve().then(async () => {
    let timeout;
    try {
      const controller = new AbortController();
      timeout = setTimeout(() => controller.abort(), 8000);
      const response = await fetch("https://api.chatterino.com/badges", {
        credentials: "omit",
        signal: controller.signal
      });
      if (!response.ok) throw new Error("Chatterino badges unavailable");
      const data = await response.json();
      if (!Array.isArray(data?.badges)) throw new Error("Invalid Chatterino catalog");

      const nextCache = new Map();
      for (const badge of data.badges) {
        if (!Array.isArray(badge?.users)) continue;
        const url = [badge.image3, badge.image2, badge.image1]
          .find(value => typeof value === "string" && /^https:\/\//i.test(value));
        if (!url) continue;
        const value = {
          url,
          tooltip: String(badge.tooltip || "Chatterino Badge")
        };
        for (const userId of badge.users) {
          const id = String(userId || "").trim();
          // Match Chatterino's last-entry-wins behavior for duplicate IDs.
          if (/^\d+$/.test(id)) nextCache.set(id, value);
        }
      }
      chatterinoBadgeCache = nextCache;
      chatterinoBadgeNextFetchAt = Date.now() + CHATTERINO_BADGE_CACHE_MS;
    } catch (_) {
      // Keep any previous catalog and back off; chat never depends on this request.
      chatterinoBadgeNextFetchAt = Date.now() + CHATTERINO_BADGE_RETRY_MS;
    } finally {
      clearTimeout(timeout);
      chatterinoBadgeLoading = null;
    }
    return chatterinoBadgeCache;
  });
  return chatterinoBadgeLoading;
}

async function attachChatterinoBadge(messageEl, username, twitchUserId) {
  try {
    const id = String(twitchUserId || "").trim();
    const settings = getBadgeSettings(username);
    if (!/^\d+$/.test(id) || !settings.showBadges || !settings.showChatterinoBadges) return;

    const appendCachedBadge = () => {
      // Never recreate a message removed by moderation or its lifetime timer.
      if (messageEl.parentNode !== chatContainer || messageEl.dataset.removing === "true") return;
      const holder = messageEl.querySelector(".badges");
      const badge = chatterinoBadgeCache.get(id);
      if (!holder || !badge || holder.querySelector(".chatterino-badge")) return;
      const count = Array.from(holder.children)
        .filter(element => element.classList.contains("badge")).length;
      if (count >= getBadgeSettings(username).maxBadges) return;

      const fragment = document.createElement("span");
      fragment.innerHTML = buildVisibleBadgeHTML({ username, chatterinoBadge: badge });
      const image = fragment.firstElementChild;
      if (!image) return;
      image.addEventListener("error", () => image.remove(), { once: true });
      holder.appendChild(image);
      syncProfilePictureBadgeSpacing(messageEl);
    };

    appendCachedBadge();
    await loadChatterinoBadges();
    appendCachedBadge();
  } catch (_) {
    // Badge lookup or image attachment must never interrupt message rendering.
  }
}

/* FFZ's public ID catalog includes badge definitions and their Twitch owners. */
let ffzBadgeCache = new Map();
let ffzBadgeLoading = null;
let ffzBadgeNextFetchAt = 0;
const FFZ_BADGE_CACHE_MS = 6 * 60 * 60 * 1000;
const FFZ_BADGE_RETRY_MS = 5 * 60 * 1000;

function loadFFZBadges() {
  if (ffzBadgeLoading) return ffzBadgeLoading;
  if (Date.now() < ffzBadgeNextFetchAt) return Promise.resolve(ffzBadgeCache);

  ffzBadgeLoading = Promise.resolve().then(async () => {
    let timeout;
    try {
      const controller = new AbortController();
      timeout = setTimeout(() => controller.abort(), 8000);
      const response = await fetch("https://api.frankerfacez.com/v1/badges/ids", {
        credentials: "omit",
        signal: controller.signal
      });
      if (!response.ok) throw new Error("FFZ badges unavailable");
      const data = await response.json();
      if (!Array.isArray(data?.badges) || !data.users ||
          typeof data.users !== "object" || Array.isArray(data.users)) {
        throw new Error("Invalid FFZ catalog");
      }

      const nextCache = new Map();
      for (const badge of data.badges) {
        const badgeId = String(badge?.id ?? "");
        const owners = data.users[badgeId];
        if (!/^\d+$/.test(badgeId) || !Array.isArray(owners)) continue;
        const url = [badge.urls?.["4"], badge.urls?.["2"], badge.urls?.["1"], badge.image]
          .filter(value => typeof value === "string")
          .map(value => value.startsWith("//") ? `https:${value}` : value)
          .find(value => /^https:\/\//i.test(value));
        if (!url) continue;
        const value = {
          id: badgeId,
          url,
          title: String(badge.title || "FFZ Badge"),
          color: /^#(?:[\da-f]{3}|[\da-f]{6}|[\da-f]{8})$/i.test(badge.color || "")
            ? badge.color : "transparent"
        };
        for (const userId of owners) {
          const id = String(userId || "").trim();
          if (!/^\d+$/.test(id)) continue;
          if (!nextCache.has(id)) nextCache.set(id, []);
          const badges = nextCache.get(id);
          if (!badges.some(item => item.id === badgeId)) badges.push(value);
        }
      }
      ffzBadgeCache = nextCache;
      ffzBadgeNextFetchAt = Date.now() + FFZ_BADGE_CACHE_MS;
    } catch (_) {
      // Retain any previous catalog; failures never interrupt chat.
      ffzBadgeNextFetchAt = Date.now() + FFZ_BADGE_RETRY_MS;
    } finally {
      clearTimeout(timeout);
      ffzBadgeLoading = null;
    }
    return ffzBadgeCache;
  });
  return ffzBadgeLoading;
}

async function attachFFZBadges(messageEl, username, twitchUserId, chatterinoReady) {
  try {
    const id = String(twitchUserId || "").trim();
    const settings = getBadgeSettings(username);
    if (!/^\d+$/.test(id) || !settings.showBadges || !settings.showFFZBadges) return;

    const appendCachedBadges = () => {
      if (messageEl.parentNode !== chatContainer || messageEl.dataset.removing === "true") return;
      const holder = messageEl.querySelector(".badges");
      if (!holder) return;
      const existing = Array.from(holder.children)
        .filter(element => element.classList.contains("badge"));
      const available = Math.max(0, getBadgeSettings(username).maxBadges - existing.length);
      if (!available) return;
      const badges = (ffzBadgeCache.get(id) || [])
        .filter(badge => !existing.some(element => element.dataset.ffzBadgeId === badge.id))
        .slice(0, available);
      const fragment = document.createElement("span");
      fragment.innerHTML = buildVisibleBadgeHTML({ username, ffzBadges: badges });
      for (const image of Array.from(fragment.children)) {
        image.addEventListener("error", () => image.remove(), { once: true });
        holder.appendChild(image);
      }
      syncProfilePictureBadgeSpacing(messageEl);
    };

    const loading = loadFFZBadges();
    // Fetch concurrently, but preserve Chatterino's position and badge priority.
    await chatterinoReady;
    appendCachedBadges();
    await loading;
    appendCachedBadges();
  } catch (_) {
    // A late lookup cannot prevent rendering or recreate a removed message.
  }
}

function getFallbackProfilePicture(username, color = "") {
  const c = String(color || "").trim().toLowerCase();

  if (fallbackProfileCache[c]) return fallbackProfileCache[c];

  let icon = fallbackProfileIcons[1];

  if (c.startsWith("#") && c.length >= 7) {
    const r = parseInt(c.slice(1, 3), 16);
    const g = parseInt(c.slice(3, 5), 16);
    const b = parseInt(c.slice(5, 7), 16);

    if (g > r && g > b) icon = fallbackProfileIcons[0];
    else if (b > r && b > g) icon = fallbackProfileIcons[1];
    else if (r > g && r > b) icon = fallbackProfileIcons[2];
    else if (r > 180 && b > 180) icon = fallbackProfileIcons[7];
    else if (r > 150 && b > 120) icon = fallbackProfileIcons[3];
    else if (r > 180 && g > 140 && b < 100) icon = fallbackProfileIcons[5];
    else if (r > 180 && g > 180 && b < 120) icon = fallbackProfileIcons[4];
    else if (g > 150 && b > 150) icon = fallbackProfileIcons[6];
  }

  fallbackProfileCache[c || username] = icon;
  return icon;
}

function normalizeEmotes(emotes = []) {
  if (!emotes) return [];
  return Array.isArray(emotes) ? emotes : Object.values(emotes);
}

function getEmoteName(emote) {
  return emote.name || emote.code || emote.displayName || emote.text || "";
}

function getEmoteUrl(emote) {
  return (
    emote.url ||
    emote.urls?.["4"] ||
    emote.urls?.["3"] ||
    emote.urls?.["2"] ||
    emote.urls?.["1"] ||
    emote.image_url ||
    emote.imageUrl ||
    emote.src ||
    ""
  );
}

function getEmoteId(emote) {
  return emote.id || emote.emoteId || emote.emote_id || "";
}

function parseEmotes(message, emotes = []) {
  const normalizedEmotes = [
    ...normalizeEmotes(emotes),
    ...Object.values(combinedSevenTVEmotes("twitch"))
  ];

  return String(message || "")
    .split(/(\s+)/)
    .map(part => {
      if (part.trim() === "") return part;

      const match = part.match(/^([^\w]*)([\w]+)([^\w]*)$/);
      if (!match) return parseNativeEmoji(part);

      const prefix = match[1];
      const word = match[2];
      const suffix = match[3];

      const emoteMatch = normalizedEmotes.find(emote => {
        return getEmoteName(emote) === word;
      });

      if (emoteMatch) {
        const directUrl = getEmoteUrl(emoteMatch);
        const emoteId = getEmoteId(emoteMatch);

        const src = directUrl || (
          emoteId
            ? `https://static-cdn.jtvnw.net/emoticons/v2/${emoteId}/default/dark/3.0`
            : ""
        );

        if (src) {
          return `${parseNativeEmoji(prefix)}<img
            class="emote"
            src="${escapeHTML(src)}"
            alt="${escapeHTML(word)}"
            title="${escapeHTML(word)}"
          >${parseNativeEmoji(suffix)}`;
        }
      }

      return parseNativeEmoji(part);
    })
    .join("");
}


function parseTwitchGifMetadata(gifData = "") {
  const raw = String(gifData || "").trim();
  if (!raw) return null;

  const firstPipe = raw.indexOf("|");
  const secondPipe = raw.indexOf("|", firstPipe + 1);

  if (firstPipe <= 0 || secondPipe <= firstPipe + 1) {
    debugWarn("Could not parse Twitch GIF tag:", raw);
    return null;
  }

  const rangeText = raw.slice(0, firstPipe).trim();
  const gifId = raw.slice(firstPipe + 1, secondPipe).trim();
  const rawUrl = raw.slice(secondPipe + 1).trim();

  const rangeMatch = rangeText.match(/^(\d+)-(\d+)$/);

  let gifUrl = "";

  try {
    const parsedUrl = new URL(rawUrl);
    const hostname = parsedUrl.hostname.toLowerCase();

    if (
      parsedUrl.protocol === "https:" &&
      (hostname === "giphy.com" || hostname.endsWith(".giphy.com"))
    ) {
      gifUrl = parsedUrl.href;
    }
  } catch (error) {
    debugWarn("Invalid Twitch GIF URL:", rawUrl);
  }

  if (!gifUrl) return null;

  return {
    start: rangeMatch ? Number(rangeMatch[1]) : -1,
    end: rangeMatch ? Number(rangeMatch[2]) : -1,
    id: gifId,
    url: gifUrl
  };
}

function parseTwitchMessageWithGif(message, emotes = [], gifData = "") {
  const text = String(message || "");
  const gif = parseTwitchGifMetadata(gifData);

  if (!gif) {
    return parseEmotes(text, emotes);
  }

  let start = gif.start;
  let end = gif.end;

  const rangeIsValid =
    Number.isInteger(start) &&
    Number.isInteger(end) &&
    start >= 0 &&
    end >= start &&
    end < text.length;

  const rangedText =
    rangeIsValid
      ? text.slice(start, end + 1)
      : "";

  const rangeLooksLikeGif =
    /^\[[^\]]*\bGIF by [^\]]+\]$/i.test(rangedText);

  /*
   * Twitch gives the GIF placeholder's character range in the `gifs` tag.
   * Reply cleanup can shift those indexes, so fall back to locating the
   * bracketed GIF label if the supplied range no longer matches.
   */
  if (!rangeIsValid || !rangeLooksLikeGif) {
    const placeholderMatch = text.match(/\[[^\]]*\bGIF by [^\]]+\]/i);

    if (placeholderMatch && placeholderMatch.index !== undefined) {
      start = placeholderMatch.index;
      end = start + placeholderMatch[0].length - 1;
    } else {
      start = text.length;
      end = text.length - 1;
    }
  }

  const beforeText = text.slice(0, start);
  const placeholderText =
    end >= start
      ? text.slice(start, end + 1)
      : "";
  const afterText =
    end >= start
      ? text.slice(end + 1)
      : "";

  const altText =
    placeholderText
      .replace(/^\[/, "")
      .replace(/\]$/, "")
      .trim() ||
    "Twitch GIF";

  const gifHTML = `<img
    class="twitch-gif twitch-gif-pending"
    src="${escapeHTML(gif.url)}"
    alt="${escapeHTML(altText)}"
    title="${escapeHTML(altText)}"
    loading="eager"
  >`;

  return (
    parseEmotes(beforeText, emotes) +
    gifHTML +
    parseEmotes(afterText, emotes)
  );
}

function applyTwitchGifSize(image) {
  if (!image) return;

  const naturalWidth = Number(image.naturalWidth || 0);
  const naturalHeight = Number(image.naturalHeight || 0);

  if (naturalWidth <= 0 || naturalHeight <= 0) return;

  /*
   * Recreate the exact v1.11 baseline first: never upscale beyond the
   * source image, and fit inside 320x240. Then apply the user's percentage
   * to that baseline width. Height stays auto so the GIF can never stretch.
   */
  const baseFitScale = Math.min(
    1,
    320 / naturalWidth,
    240 / naturalHeight
  );

  const baseWidth = naturalWidth * baseFitScale;
  const targetWidth = Math.max(1,
    baseWidth * (twitchGifSizePercent / 100)
  );

  image.style.setProperty(
    "width",
    `${targetWidth}px`,
    "important"
  );
  image.style.setProperty("height", "auto", "important");
  image.style.setProperty("max-width", "100%", "important");
  image.style.setProperty("max-height", "none", "important");

  /*
   * Keep the GIF out of layout until its final width is known. Removing the
   * pending class only after all sizing styles are applied prevents a single
   * frame of the GIF rendering at its large fallback/intrinsic size.
   */
  image.classList.remove("twitch-gif-pending");
}

function wireTwitchGifSizing(container) {
  container
    ?.querySelectorAll("img.twitch-gif")
    .forEach(image => {
      if (image.complete && image.naturalWidth > 0) {
        applyTwitchGifSize(image);
        return;
      }

      image.addEventListener(
        "load",
        () => applyTwitchGifSize(image),
        { once: true }
      );
    });
}

function parseKickMessage(message, emotes = []) {
  const normalizedEmotes = [
    ...normalizeEmotes(emotes),
    ...Object.values(kickChannelEmotes),
    ...Object.values(combinedSevenTVEmotes("kick"))
  ];

  const emoteByName = new Map();
  const emoteById = new Map();

  normalizedEmotes.forEach(emote => {
    const name = getEmoteName(emote);
    const id = String(getEmoteId(emote) || "");

    if (name) emoteByName.set(name, emote);
    if (id) emoteById.set(id, emote);
  });

  const parts = String(message || "").split(/(\s+)/);

  return parts.map(part => {
    if (part.trim() === "") return part;

    let output = "";
    let lastIndex = 0;
    const tokenPattern = /\[emote:(\d+):([^\]]+)\]/g;
    let tokenMatch;

    while ((tokenMatch = tokenPattern.exec(part)) !== null) {
      output += parseNativeEmoji(part.slice(lastIndex, tokenMatch.index));

      const id = tokenMatch[1];
      const name = tokenMatch[2];
      const known = emoteById.get(id) || emoteByName.get(name);
      const src =
        getEmoteUrl(known || {}) ||
        `https://files.kick.com/emotes/${encodeURIComponent(id)}/fullsize`;

      output += `<img
        class="emote kick-emote"
        src="${escapeHTML(src)}"
        alt="${escapeHTML(name)}"
        title="${escapeHTML(name)}"
      >`;

      lastIndex = tokenPattern.lastIndex;
    }

    if (lastIndex > 0) {
      output += parseNativeEmoji(part.slice(lastIndex));
      return output;
    }

    const wordMatch = part.match(/^([^\w]*)([\w]+)([^\w]*)$/);
    if (!wordMatch) return parseNativeEmoji(part);

    const prefix = wordMatch[1];
    const word = wordMatch[2];
    const suffix = wordMatch[3];
    const known = emoteByName.get(word);

    if (!known) return parseNativeEmoji(part);

    const src =
      getEmoteUrl(known) ||
      `https://files.kick.com/emotes/${encodeURIComponent(
        getEmoteId(known)
      )}/fullsize`;

    return `${parseNativeEmoji(prefix)}<img
      class="emote kick-emote"
      src="${escapeHTML(src)}"
      alt="${escapeHTML(word)}"
      title="${escapeHTML(word)}"
    >${parseNativeEmoji(suffix)}`;
  }).join("");
}

function isFirstMessage(data) {
  const tags = data.tags || {};

  return (
    data.firstMsg === true ||
    data.firstMessage === true ||
    data.isFirstMessage === true ||
    data["first-msg"] === true ||
    data["first-msg"] === "1" ||
    tags.firstMsg === true ||
    tags.firstMsg === "1" ||
    tags["first-msg"] === true ||
    tags["first-msg"] === "1"
  );
}

async function loadSevenTVPaintCatalog() {
  const catalogIsFresh =
    sevenTVPaintCatalogLoadedAt > 0 &&
    Date.now() - sevenTVPaintCatalogLoadedAt <
      SEVENTV_PAINT_CATALOG_CACHE_TIME;

  if (catalogIsFresh) {
    return sevenTVPaintCache;
  }

  if (sevenTVPaintCatalogPromise) {
    return sevenTVPaintCatalogPromise;
  }

  sevenTVPaintCatalogPromise = (async () => {
    try {
      const response = await fetch("https://7tv.io/v3/gql", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          query: `
            query {
              cosmetics {
                paints {
                  id
                  name
                  function
                  color
                  image_url
                  angle
                  shape
                  repeat
                  stops {
                    at
                    color
                  }
                  shadows {
                    x_offset
                    y_offset
                    radius
                    color
                  }
                }
              }
            }
          `
        })
      });

      if (!response.ok) {
        throw new Error(`7TV paint catalog HTTP ${response.status}`);
      }

      const data = await response.json();
      const paints = data?.data?.cosmetics?.paints || [];

      paints.forEach(paint => {
        if (paint?.id) {
          sevenTVPaintCache[paint.id] = paint;
        }
      });

      sevenTVPaintCatalogLoadedAt = Date.now();

      debugLog(
        `7TV paint catalog cached: ${paints.length} paints.`
      );

      return sevenTVPaintCache;
    } catch (error) {
      debugError("7TV paint catalog load failed:", error);
      return sevenTVPaintCache;
    } finally {
      sevenTVPaintCatalogPromise = null;
    }
  })();

  return sevenTVPaintCatalogPromise;
}

async function loadSevenTVPaint(paintId) {
  if (!paintId) return null;

  if (sevenTVPaintCache[paintId]) {
    return sevenTVPaintCache[paintId];
  }

  await loadSevenTVPaintCatalog();
  return sevenTVPaintCache[paintId] || null;
}

function normalizeSevenTVAvatarUrl(value) {
  const url = String(value || "").trim();
  if (!url) return "";

  /*
   * 7TV custom/animated avatars are commonly returned as protocol-relative
   * CDN URLs (for example //cdn.7tv.app/pp/...). StreamElements can render
   * widgets in an iframe context where leaving the scheme implicit may
   * resolve badly, so always make 7TV avatar URLs explicitly HTTPS.
   */
  if (url.startsWith("//")) return `https:${url}`;
  if (/^https:\/\//i.test(url)) return url;

  return "";
}

async function loadSevenTVCosmetics(twitchUserId, username = "") {
  if (!twitchUserId) return null;

  const key = String(twitchUserId);
  const cached = sevenTVCosmeticCache[key];

  if (cached) {
    /*
     * Keep successful Twitch 7TV cosmetic results for the lifetime of this
     * widget instance. That means the resolved 7TV avatar/PFP is reused
     * immediately on every later message and only clears when the widget
     * itself is refreshed/reloaded.
     *
     * Failed / missing lookups still use the short retry window so a
     * temporary 7TV miss can recover without forcing a widget refresh.
     */
    if (cached.cosmetics !== null) {
      return cached.cosmetics;
    }

    if (Date.now() - cached.cachedAt < SEVENTV_NEGATIVE_CACHE_TIME) {
      return null;
    }
  }

  /*
   * Store and return the actual Promise rather than a boolean.
   * Multiple messages from the same uncached user now wait for one
   * lookup and all receive the same finished cosmetics result.
   */
  if (sevenTVCosmeticLoading[key]) {
    return sevenTVCosmeticLoading[key];
  }

  sevenTVCosmeticLoading[key] = (async () => {
    try {
      const response = await fetch("https://7tv.io/v3/gql", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          operationName: "GetUserByConnection",
          variables: {
            id: String(key),
            platform: "TWITCH"
          },
          query: `
            query GetUserByConnection($platform: ConnectionPlatform!, $id: String!) {
              user: userByConnection(platform: $platform, id: $id) {
                id
                username
                display_name
                avatar_url
                style {
                  color
                  paint_id
                  badge_id
                  __typename
                }
                connections {
                  platform
                  emote_set_id
                  __typename
                }
                roles
                __typename
              }
            }
          `
        })
      });

      if (!response.ok) {
        throw new Error(`7TV Twitch user HTTP ${response.status}`);
      }

      const result = await response.json();
      const user = result?.data?.user;

      if (!user) {
        sevenTVCosmeticCache[key] = {
          cosmetics: null,
          cachedAt: Date.now()
        };

        return null;
      }

      const style = user?.style || {};
      const paintData = style.paint_id
        ? await loadSevenTVPaint(style.paint_id)
        : null;

      const cosmetics = {
        color: style.color || null,
        paintId: style.paint_id || null,
        badgeId: style.badge_id || null,
        badgeUrl: style.badge_id
          ? `https://cdn.7tv.app/badge/${style.badge_id}/4x.webp`
          : null,
        avatarUrl: normalizeSevenTVAvatarUrl(user?.avatar_url),
        paintData,
        raw: user,
        username
      };

      sevenTVCosmeticCache[key] = {
        cosmetics,
        cachedAt: Date.now()
      };

      return cosmetics;
    } catch (error) {
      debugError("7TV Twitch cosmetic lookup failed:", error);

      sevenTVCosmeticCache[key] = {
        cosmetics: null,
        cachedAt: Date.now()
      };

      return null;
    } finally {
      delete sevenTVCosmeticLoading[key];
    }
  })();

  return sevenTVCosmeticLoading[key];
}


