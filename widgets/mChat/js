function buildReplyPreview(data) {
  const tags = data.tags || {};

  const replyUser =
    tags["reply-parent-display-name"] ||
    tags["reply-parent-user-login"] ||
    data.replyParentDisplayName ||
    data.replyParentUserLogin ||
